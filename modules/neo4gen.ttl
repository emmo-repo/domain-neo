:NuclearMaterial rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/emmo/hume#Material> ;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "Nuclear Fission Material"@en ;
