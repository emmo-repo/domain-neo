                  rdfs:subClassOf :NuclearMaterial ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Nuclear fuel removed from a reactor following irradiation that is no longer usable in its present form because of depletion of fissile material, poison buildup or radiation damage."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Spent Fuel"@en ;
                  :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/1230.html"^^xsd:anyURI .


