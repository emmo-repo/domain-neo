:ActivatedMaterial a owl:Class;
  rdfs:subClassOf :NuclearMaterial;
  rdfs:comment "the definition is not correct: Mix between nuclide and material";
  rdfs:isDefinedBy <https://en.wikipedia.org/wiki/Activation_product>;
  <http://www.w3.org/2004/02/skos/core#definition> "An activation product is a material that has been made radioactive by the process of neutron activation."@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Activated Material"@en;
  :RR3uD2d7YfhHohfv2Nm6sX "Fission products and actinides produced by neutron absorption of nuclear fuel itself are normally referred to by those specific names, and activation product reserved for products of neutron capture by other materials, such as structural components of the nuclear reactor or nuclear bomb, the reactor coolant, control rods or other neutron poisons, or materials in the environment. All of these, however, need to be handled as radioactive waste. Some nuclides originate in more than one way, as activation products or fission products."@en .

:Atom a owl:Class;
  rdfs:subClassOf <../hume#PhysicalParticle> .

:BoilingWaterReactor a owl:Class .

:BoratedWater a owl:Class;
  rdfs:subClassOf <../hume#Fluid>;
  rdfs:seeAlso "https://www.columbuschemical.com/MSDS/SDS/Borated%20Water%200881.pdf";
  <http://www.w3.org/2004/02/skos/core#altLabel> "Injected Borated Water";
  <http://www.w3.org/2004/02/skos/core#definition> "Boron, often in the form of boric acid or sodium borate, is combined with water where it acts as a coolant to remove heat from the reactor core and transfers the heat to a secondary circuit.";
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Borated Water"@en .

_:genid1 a owl:Axiom;
  owl:annotatedSource :BoratedWater;
  owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition>;
  owl:annotatedTarget "Boron, often in the form of boric acid or sodium borate, is combined with water where it acts as a coolant to remove heat from the reactor core and transfers the heat to a secondary circuit.";
  rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Nuclear_reactor_coolant" .

:Ceramic_Material a owl:Class;
  rdfs:subClassOf <../hume#Material>;
  <http://www.w3.org/2004/02/skos/core#comment> """essentially inorganic and non-metallic material (3.1.12)
Note 1 to entry: The concept “ceramic” comprises products based on clay as raw material and also materials which are typically based on oxides, nitrides, carbides, silicides, borides, carbon etc.""";
  :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:23020:ed-1:v1:en:term:3.1.4> .

:Cermet a owl:Class;
  rdfs:subClassOf <../hume#Material>;
  rdfs:comment "sintered material (3.5.10) containing at least one metallic phase and at least one non-metallic phase which is generally of a ceramic nature and the main constituent being titanium carbide, titanium nitride and titanium";
  :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:3252:ed-6:v1:en:term:3.5.1> .

:Cilinder_Height a owl:Class;
  rdfs:subClassOf :Height;
  :RR3uD2d7YfhHohfv2Nm6sX "The height is the minimum length of a straight line segment between the two parallel planes containing the bases of the cylinder. In relation to the longitudinal axis (the derived feature passing through the centers of the bases), the height is defined as the orthogonal projection of the axis length onto the normal to the base planes" .

:Cladding a owl:Class;
  rdfs:comment "The thin-walled metal tube that forms the outer jacket of a nuclear fuel rod. It prevents corrosion of the fuel by the coolant and the release of fission products into the coolant. Aluminum, stainless steel, and zirconium alloys are common cladding materials.";
  :referenceNRC <https://www.nrc.gov/reading-rm/basic-ref/glossary/cladding> .

:Depleted_Uranium a owl:Class;
  rdfs:subClassOf :UraniumMaterial;
  <http://www.w3.org/2004/02/skos/core#comment> "Uranium in which the percentage of U-235 is less than that of natural uranium (< 0.711%). A by-product of the enrichment process.";
  :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/285.html> .

:Enriched_Uranium a owl:Class;
  rdfs:subClassOf :UraniumMaterial;
  <http://www.w3.org/2004/02/skos/core#comment> "rdfs:comment \"Uranium in which the proportion of U-235 has been increased above that of natural uranium.";
  :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/286.html> .

:FastNeutron a owl:Class;
  rdfs:subClassOf :Neutron .

:Fertile_Nuclide a owl:Class .

:Fissile_Nuclide a owl:Class .

:FissionProduct a owl:Class;
  rdfs:subClassOf :Atom;
  rdfs:comment "Used in contexts where the radiation emitted by the radionuclide is the potential hazard."@en;
  <http://www.w3.org/2004/02/skos/core#definition> "A radionuclide produced by nuclear fission."@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Fission Product"@en;
  :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/961.html"^^xsd:anyURI .

:Fissionable_Nuclide a owl:Class;
  :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/963.html> .

:Fresh_Pellet a owl:Class;
  :R8xx0dhbEh1tjGMDwNZfckV "A fuel pellet that has not yet been subjected to an irradiation process within a nuclear reactor." .

:FuelAssembly a owl:Class;
  <http://www.w3.org/2004/02/skos/core#definition> """A set of fuel elements and associated components which are loaded into and
subsequently removed from a reactor core as a single unit."""@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Fuel Assembly"@en;
  :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/974.html"^^xsd:anyURI .

:FuelElement a owl:Class;
  rdfs:comment "Commonly referred to as a fuel rod in light water reactors."@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Fuel Element"@en, "Fuel Pin";
  <http://www.w3.org/2004/02/skos/core#definition> "A rod of nuclear fuel, its cladding and any associated components necessary to form a structural entity.﻿"@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Fuel Rod"@en;
  :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/976.html"^^xsd:anyURI .

:Fuel_Pellet a owl:Class;
  rdfs:subClassOf _:genid2, _:genid3;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Nuclear Fuel Pellet";
  <http://www.w3.org/2004/02/skos/core#comment> "nuclear fuel (3.2.1) in ceramic form and with a cylindrical shape";
  <http://www.w3.org/2004/02/skos/core#definition> "nuclear fuel with a geometrical shape, and a chemical composition that is fabricated for nuclear civil reactor and research reactors."@en;
  :R8xx0dhbEh1tjGMDwNZfckV "A discrete unit of nuclear fuel material, characterized by a specific ceramic form and cylindrical geometry, fabricated to serve as the structural basis for fuel rod integration. Its identity as a pellet is defined by its physical properties (shape, material matrix, dimensions) rather than its functional state within a reactor.";
  :referenceISO "https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-3:ed-2:v1:en:term:3.2.3"^^xsd:anyURI .

_:genid2 a owl:Restriction;
  owl:someValuesFrom :Isotopic_Vector;
  owl:onProperty <../hume#hasProperty> .

_:genid3 a owl:Restriction;
  owl:someValuesFrom :Shape;
  owl:onProperty <../hume#hasProperty> .

_:genid4 a owl:Axiom;
  owl:annotatedSource :Fuel_Pellet;
  owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#comment>;
  owl:annotatedTarget "nuclear fuel (3.2.1) in ceramic form and with a cylindrical shape";
  rdfs:comment "the definition does not include types of pellet for fast reactor with other fors of other material matrix" .

:Fuel_Pellet_Column a owl:Class;
  :R8xx0dhbEh1tjGMDwNZfckV "multiple pellets stacked on top of each other in axial direction within a fuel rod. also called FUEL COLUMN" .

:Geometrical_Property a owl:Class;
  rdfs:subClassOf <../hume#Property>;
  :R8xx0dhbEh1tjGMDwNZfckV "A physical property that characterizes the spatial extent, shape, or dimensions of an entity (such as a fuel pellet) within a three-dimensional Euclidean space." .

:Height a owl:Class;
  rdfs:subClassOf :Geometrical_Property;
  rdfs:seeAlso "add link Batt info";
  :R8xx0dhbEh1tjGMDwNZfckV """Height
https://w3id.org/emmo#EMMO_08bcf1d6_e719_46c8_bb21_24bc9bf34dba
ElucidationMinimum length of a straight line segment between a point and a reference line or reference surface.IEC Referencehttps://www.electropedia.org/iev/iev.nsf/display?openform&ievref=113-01-21Wikipedia Referencehttps://en.wikipedia.org/wiki/HeightWikidata Referencehttps://www.wikidata.org/wiki/Q208826

Reference ISO 80000""" .

:Hydrogen a owl:Class;
  rdfs:subClassOf :Atom;
  rdfs:isDefinedBy <https://en.wikipedia.org/wiki/Hydrogen>;
  <http://www.w3.org/2004/02/skos/core#definition> "Itis a chemical element; it has symbol H and atomic number 1. It is the lightest element and, at standard conditions, is a gas of diatomic molecules with the formula H2. It is colorless, odorless, tasteless, non-toxic, and highly combustible. Hydrogen is the most abundant chemical substance in the universe, constituting roughly 75% of all normal matter."@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Hydrogen"@en .

:Inner_Radius a owl:Class;
  rdfs:subClassOf :Radius;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Fuel Inner Radius";
  :R8xx0dhbEh1tjGMDwNZfckV "the geometric distance between the longitudinal axis of symmetry of the entity and the internal cylindrical surface that bounds the central axial cavity" .

:IrradiatedFuel a owl:Class;
  rdfs:subClassOf :NuclearMaterial;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Irradiated Fuel" .

:Irradiated_Pellet a owl:Class;
  :R8xx0dhbEh1tjGMDwNZfckV "A fuel pellet that has served as input for at least one irradiation process in a nuclear reactor" .

:Irradiation a owl:Class;
  :NCTG_Reference "Irradiation";
  :RR3uD2d7YfhHohfv2Nm6sX """Exposure to ionizing radiation.' See exposure
(alternative definition).""" .

:Isotopic_Vector a owl:Class;
  rdfs:subClassOf <../hume#Property>;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Isotopic Composition";
  :R8xx0dhbEh1tjGMDwNZfckV "list of weight-percentage of isotopes in heavy metal of the fuel matrix";
  :RR3uD2d7YfhHohfv2Nm6sX "An isotopic vector describes the composition of a material in terms of the relative quantities of its constituent nuclides." .

:Light_Water_Reactor a owl:Class .

:NPPActivationProduct a owl:Class;
  rdfs:subClassOf :FissionProduct;
  rdfs:comment "Fission products and actinides produced by neutron absorption of nuclear fuel itself are normally referred to by those specific names, and activation product reserved for products of neutron capture by other materials, such as structural components of the nuclear reactor or nuclear bomb, the reactor coolant, control rods or other neutron poisons, or materials in the environment. All of these, however, need to be handled as radioactive waste. Some nuclides originate in more than one way, as activation products or fission products."@en;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Activation_product>;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "NPP Activation Product"@en .

_:genid5 a owl:Axiom;
  owl:annotatedSource :NPPActivationProduct;
  owl:annotatedProperty rdfs:comment;
  owl:annotatedTarget "Fission products and actinides produced by neutron absorption of nuclear fuel itself are normally referred to by those specific names, and activation product reserved for products of neutron capture by other materials, such as structural components of the nuclear reactor or nuclear bomb, the reactor coolant, control rods or other neutron poisons, or materials in the environment. All of these, however, need to be handled as radioactive waste. Some nuclides originate in more than one way, as activation products or fission products."@en;
  rdfs:comment "If thi is a material this is not good" .

:Natural_Uranium a owl:Class;
  rdfs:subClassOf :UraniumMaterial;
  <http://www.w3.org/2004/02/skos/core#comment> "Uranium with its naturally occurring isotopic composition (approx. 0.711% U-235).";
  :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/289.html> .

:NaturallyRadioactiveMaterial a owl:Class;
  rdfs:subClassOf :RadioactiveMaterialByOccurrence;
  rdfs:comment """The exact definition of ‘significant amounts’ would be a regulatory decision.
Material in which the activity concentrations of the naturally occurring radionuclides have been changed by a process is included in naturally occurring radioactive material (NORM).
 Naturally occurring radioactive material or NORM should be used in the singular unless reference is explicitly being made to various materials."""@en;
  rdfs:isDefinedBy """IAEA Safety Glossary, Terminology Used in Nuclear Safety 
and Radiation Protection, 2018 Edition """;
  <http://www.w3.org/2004/02/skos/core#definition> "Radioactive material containing no significant amounts of radionuclides other than naturally occurring radionuclides.﻿"@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Naturally Radioactive Material"@en .

:Neutron a owl:Class;
  rdfs:subClassOf <../hume#PhysicalParticle> .

:Neutron_Irradiation a owl:Class;
  :R8xx0dhbEh1tjGMDwNZfckV "An interaction process where incident neutrons induce atomic displacements, nuclear transmutations, and fission reactions in the target material. Unlike simple 'exposure', this process fundamentally alters the isotopic composition, microstructure, and thermophysical properties of nuclear fuel pellets.";
  :RR3uD2d7YfhHohfv2Nm6sX "Add reference" .

:NuclearEnergyObject a owl:Class;
  rdfs:comment "Nuclear energy is a form of heat energy that can be released via reactions involving nuclear fusion or fission taking place between neutrons and protons in the nucleus of an atom. Electricity can be produced when a large amount of heat energy released is applied to generate steam from turbines (Fig. 1.4). Uranium-235, an isotope of uranium, is the most commonly used element in industrial nuclear power generators.";
  <http://www.w3.org/2004/02/skos/core#altLabel> "Nuclear Domain Object";
  <http://www.w3.org/2004/02/skos/core#comment> "nuclear related energy object and people";
  <http://www.w3.org/2004/02/skos/core#definition> "It is an object involved in the nuclear energy production, management and control.";
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Energy Object"@en .

_:genid6 a owl:Axiom;
  owl:annotatedSource :NuclearEnergyObject;
  owl:annotatedProperty rdfs:comment;
  owl:annotatedTarget "Nuclear energy is a form of heat energy that can be released via reactions involving nuclear fusion or fission taking place between neutrons and protons in the nucleus of an atom. Electricity can be produced when a large amount of heat energy released is applied to generate steam from turbines (Fig. 1.4). Uranium-235, an isotope of uranium, is the most commonly used element in industrial nuclear power generators.";
  rdfs:seeAlso "https://www.sciencedirect.com/topics/engineering/nuclear-energy" .

:NuclearFuel a owl:Class;
  rdfs:comment "Since there are not only fissionable nuclides but also fissile nuclide the definition of the IAEA does not seem correct";
  <http://www.w3.org/2004/02/skos/core#comment> """Fissionable nuclear material in the form of fabricated elements for loading
into the reactor core of a civil nuclear power plant or research reactor."""@en,
    "Here we have to put something that is related to the scope of the nuclear material otherwise there is no difference between nuclear material and fuel";
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Fuel"@en;
  :R8xx0dhbEh1tjGMDwNZfckV "Nuclear material characterized by its functional role as a neutron source within a nuclear reactor core, enabling a sustained or controlled chain reaction. Unlike generic nuclear material, which is defined by its isotopic or chemical composition, Nuclear Fuel is an entity defined by its intended use as a component within a functional whole (the Reactor Core)";
  :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/668.html"^^xsd:anyURI .

_:genid7 a owl:Axiom;
  owl:annotatedSource :NuclearFuel;
  owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#comment>;
  owl:annotatedTarget """Fissionable nuclear material in the form of fabricated elements for loading
into the reactor core of a civil nuclear power plant or research reactor."""@en;
  rdfs:comment "This is uncomplete/ not true" .

:NuclearMaterial a owl:Class;
  rdfs:subClassOf <../hume#Material>;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Nuclear Fission Material"@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Material"@en;
  :R8xx0dhbEh1tjGMDwNZfckV "material containing one or more of the following: plutonium except that with isotopic concentration exceeding 80 % in 238Pu; uranium enriched in the isotope 235 or 233; uranium containing the mixture of isotopes as occurring in nature other than in the form of ore or ore residue";
  :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-3:ed-2:v1:en:term:3.1.1>;
  :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/1355.html> .

:NuclearMaterialCategoryI a owl:Class;
  rdfs:subClassOf :NuclearMaterial;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Material Category I";
  :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/1356.html> .

:NuclearMaterialCategoryII a owl:Class;
  rdfs:subClassOf :NuclearMaterial;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nucler Material Category II";
  :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/1357.html> .

:NuclearMaterialCategoryIII a owl:Class;
  rdfs:subClassOf :NuclearMaterial;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Material category III";
  :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/1358.html> .

:NuclearPowerReactor a owl:Class .

:NuclearSpentFuel a owl:Class;
  rdfs:subClassOf :NuclearMaterial;
  <http://www.w3.org/2004/02/skos/core#definition> "Nuclear fuel removed from a reactor following irradiation that is no longer usable in its present form because of depletion of fissile material, poison buildup or radiation damage."@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Spent Fuel"@en;
  :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/1230.html"^^xsd:anyURI .

:Nuclear_Reactor a owl:Class;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Reactor"@en;
  :R8xx0dhbEh1tjGMDwNZfckV "special device having an inventory of nuclear fuel material containing fissionable nuclides (3.1.2) and often neutron moderating, neutron absorbing and cooling materials, all of them geometrically arranged in a particular neutron multiplicative configuration (3.1.10) designed and built for having the capability of initiating, maintaining and extinguishing a controlled, self-sustaining nuclear fission (3.1.1) chain reaction, under adequate safety conditions";
  :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.1.22> .

:Nuclear﻿_Fresh_Fuel a owl:Class;
  rdfs:subClassOf :NuclearFuel;
  <http://www.w3.org/2004/02/skos/core#definition> "New fuel or unirradiated fuel, including fuel fabricated from fissionable material recovered by reprocessing previously irradiated fuel.";
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear﻿ Fresh Fuel"@en;
  :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/669.html"^^xsd:anyURI .

:Nuclide a owl:Class .

:Outer_Radius a owl:Class;
  rdfs:subClassOf :Radius;
  :R8xx0dhbEh1tjGMDwNZfckV "the geometric distance between the longitudinal axis of symmetry of the entity and its external cylindrical surface." .

:PlutoniumMaterial a owl:Class;
  rdfs:subClassOf :NuclearMaterial;
  <http://www.w3.org/2004/02/skos/core#comment> "All plutonium except that with isotopic concentration exceeding 80% in plutonium-238";
  :IAEA_Reference "https://www-pub.iaea.org/MTCD/Publications/PDF/Pub1481_web.pdf sec 4" .

:RadioactiveMaterial a owl:Class;
  rdfs:subClassOf <../hume#Material>;
  rdfs:comment "Material designated in national law or by a regulatory body as being  subject to regulatory control because of its radioactivity."@en,
    """This is the ‘regulatory’ meaning of radioactive (2), and should not be confused with
the ‘scientific’ meaning of radioactive (1): ‘exhibiting radioactivity; emitting or
relating to the emission of ionizing radiation or particles’."""@en,
    """Any material containing radionuclides where both the activity
concentration and the total activity in the consignment exceed the values specified
in [section IV of the Transport Regulations [2]]. (See SSR-6 (Rev. 1) [2].)""";
  rdfs:isDefinedBy <https://www.undrr.org/understanding-disaster-risk/terminology/hips/tl0002>;
  <http://www.w3.org/2004/02/skos/core#definition> "A radioactive material is a substance or a material emitting, or related to the emission of, ionising radiation (either in the form of electromagnetic waves or particle radiation) (IAEA, 2018)."@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Radioactive Material"@en;
  :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/1192.html"^^xsd:anyURI .

:RadioactiveMaterialByOccurrence a owl:Class;
  rdfs:subClassOf :RadioactiveMaterial;
  <http://www.w3.org/2004/02/skos/core#definition> "The superclass for categorisation of nuclear materials according to their occurence, natural or artificial"@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Radioactive Material By Occurrence"@en .

:Radionuclide a owl:Class .

:Radius a owl:Class;
  rdfs:subClassOf :Geometrical_Property .

:ReactorCoolant a owl:Class;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Reactor Coolant"@en;
  :R8xx0dhbEh1tjGMDwNZfckV "A substance that is used to remove or transfer heat from the reactor core. Common coolants include light water, heavy water, air, carbon dioxide, helium, liquid sodium, and a sodium-potassium alloy."@en;
  :referenceARIS <https://aris.iaea.org/Glossary/> .

:Reactor_Core a owl:Class;
  :RR3uD2d7YfhHohfv2Nm6sX "part of a nuclear reactor (3.1.22), where the fissionable nuclides (3.1.2) sustaining the fission chain are located";
  :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.1.23.1> .

:Reactor_Core_Role a owl:Class;
  rdfs:label "Reactor Core Role"@en;
  :R8xx0dhbEh1tjGMDwNZfckV "A ReactorComponentRole is a role entity defined by its functional relationship with the ReactorCore (the 'Whole'). It does not exist as an isolated entity, but emerges the moment a physical object is integrated into the system, becoming an essential part of the reactor configuration. The existence of the ReactorCore system is ontologically dependent upon the presence of these role entities which, together, enable the controlled fission process." .

:Reactor_Moderator a owl:Class;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Reactor Moderator"@en;
  :R8xx0dhbEh1tjGMDwNZfckV "A material that is used to decrease the speed of the fast neutron produced during a fission even and thus sustaining a chain reaction."@en;
  :referenceARIS "Moderator"@en .

:ResearchReactor a owl:Class .

:SeaWater a owl:Class;
  rdfs:subClassOf <../hume#Fluid>;
  rdfs:seeAlso "https://www.iaea.org/sites/default/files/publications/magazines/bulletin/bull19-1/19105982126.pdf";
  <http://www.w3.org/2004/02/skos/core#definition> "Seawater is water from a sea or ocean.";
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Sea Water"@en .

_:genid8 a owl:Axiom;
  owl:annotatedSource :SeaWater;
  owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition>;
  owl:annotatedTarget "Seawater is water from a sea or ocean.";
  rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Seawater#" .

:Shape a owl:Class;
  rdfs:subClassOf :Geometrical_Property;
  :R8xx0dhbEh1tjGMDwNZfckV "A qualitative geometrical property that describes the spatial configuration or morphological arrangement of an entity, distinguishing it from dimensional metrics (such as length or radius)" .

:SourceMaterial a owl:Class;
  rdfs:subClassOf :NuclearMaterial;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Source Material";
  :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/402.html> .

:ThermalNeutron a owl:Class;
  rdfs:subClassOf :Neutron .

