                     :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.2.4.2> .


###  https://w3id.org/emmo/domain/neo#NPPActivationProduct
:NPPActivationProduct rdf:type owl:Class ;
                      rdfs:subClassOf :FissionProduct ;
                      rdfs:comment "Fission products and actinides produced by neutron absorption of nuclear fuel itself are normally referred to by those specific names, and activation product reserved for products of neutron capture by other materials, such as structural components of the nuclear reactor or nuclear bomb, the reactor coolant, control rods or other neutron poisons, or materials in the environment. All of these, however, need to be handled as radioactive waste. Some nuclides originate in more than one way, as activation products or fission products."@en ;
                      rdfs:seeAlso <https://en.wikipedia.org/wiki/Activation_product> ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "NPP Activation Product"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NPPActivationProduct ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Fission products and actinides produced by neutron absorption of nuclear fuel itself are normally referred to by those specific names, and activation product reserved for products of neutron capture by other materials, such as structural components of the nuclear reactor or nuclear bomb, the reactor coolant, control rods or other neutron poisons, or materials in the environment. All of these, however, need to be handled as radioactive waste. Some nuclides originate in more than one way, as activation products or fission products."@en ;
   rdfs:comment "If thi is a material this is not good"
 ] .


###  https://w3id.org/emmo/domain/neo#Natural_Uranium
:Natural_Uranium rdf:type owl:Class ;
                 rdfs:subClassOf :UraniumMaterial ;
                 <http://www.w3.org/2004/02/skos/core#comment> "Uranium with its naturally occurring isotopic composition (approx. 0.711% U-235)." ;
                 :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/289.html> .


###  https://w3id.org/emmo/domain/neo#NaturallyRadioactiveMaterial
:NaturallyRadioactiveMaterial rdf:type owl:Class ;
                              rdfs:subClassOf :RadioactiveMaterialByOccurrence ;
                              rdfs:comment """The exact definition of ‘significant amounts’ would be a regulatory decision.
Material in which the activity concentrations of the naturally occurring radionuclides have been changed by a process is included in naturally occurring radioactive material (NORM).
 Naturally occurring radioactive material or NORM should be used in the singular unless reference is explicitly being made to various materials."""@en ;
                              rdfs:isDefinedBy """IAEA Safety Glossary, Terminology Used in Nuclear Safety 
and Radiation Protection, 2018 Edition """ ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Radioactive material containing no significant amounts of radionuclides other than naturally occurring radionuclides.﻿"@en ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Naturally Radioactive Material"@en .


###  https://w3id.org/emmo/domain/neo#Neutron
:Neutron rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/emmo/hume#PhysicalParticle> ;
         <http://www.w3.org/2004/02/skos/core#definition> """subatomic particles used for neutron imaging (3.41) (NI) purposes by the neutron attenuation process in a similar fashion to X-rays (3.76)
Note 1 to entry: Neutron imaging can be used to detect changes in hydrogen abundance that can be correlated with the post-mortem (3.57) interval, i.e. the time that has elapsed since a person has died."""@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Neutron"@en ;
         :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso-iec:39794:-16:ed-1:v1:en:term:3.52> .


###  https://w3id.org/emmo/domain/neo#NuclearEnergyObject
:NuclearEnergyObject rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/emmo/hume#Object> ;
                     rdfs:comment "Nuclear energy is a form of heat energy that can be released via reactions involving nuclear fusion or fission taking place between neutrons and protons in the nucleus of an atom. Electricity can be produced when a large amount of heat energy released is applied to generate steam from turbines (Fig. 1.4). Uranium-235, an isotope of uranium, is the most commonly used element in industrial nuclear power generators." ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Nuclear Domain Object" ;
                     <http://www.w3.org/2004/02/skos/core#comment> "nuclear related energy object and people" ;
                     <http://www.w3.org/2004/02/skos/core#definition> "It is an object involved in the nuclear energy production, management and control." ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Energy Object"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NuclearEnergyObject ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Nuclear energy is a form of heat energy that can be released via reactions involving nuclear fusion or fission taking place between neutrons and protons in the nucleus of an atom. Electricity can be produced when a large amount of heat energy released is applied to generate steam from turbines (Fig. 1.4). Uranium-235, an isotope of uranium, is the most commonly used element in industrial nuclear power generators." ;
   rdfs:seeAlso "https://www.sciencedirect.com/topics/engineering/nuclear-energy"
 ] .


###  https://w3id.org/emmo/domain/neo#NuclearEnergyProcess
:NuclearEnergyProcess rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/emmo/hume#Process> .


###  https://w3id.org/emmo/domain/neo#NuclearFuel
:NuclearFuel rdf:type owl:Class ;
             rdfs:subClassOf :NuclearMaterial ,
                             :Reactor_Core_Role ;
             rdfs:comment "Since there are not only fissionable nuclides but also fissile nuclide the definition of the IAEA does not seem correct" ;
             <http://www.w3.org/2004/02/skos/core#comment> """Fissionable nuclear material in the form of fabricated elements for loading
into the reactor core of a civil nuclear power plant or research reactor."""@en ,
                                                           "Here we have to put something that is related to the scope of the nuclear material otherwise there is no difference between nuclear material and fuel" ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Fuel"@en ;
             :R8xx0dhbEh1tjGMDwNZfckV "Nuclear material characterized by its functional role as a neutron source within a nuclear reactor core, enabling a sustained or controlled chain reaction. Unlike generic nuclear material, which is defined by its isotopic or chemical composition, Nuclear Fuel is an entity defined by its intended use as a component within a functional whole (the Reactor Core)" ;
             :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/668.html"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NuclearFuel ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#comment> ;
   owl:annotatedTarget """Fissionable nuclear material in the form of fabricated elements for loading
into the reactor core of a civil nuclear power plant or research reactor."""@en ;
   rdfs:comment "This is uncomplete/ not true"
 ] .


