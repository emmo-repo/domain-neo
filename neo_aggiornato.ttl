link: https://www-pub.iaea.org/MTCD/Publications/PDF/AdditionalVolumes/P1710/Pub1710-TV1-Web.pdf."""@en ,
                                      "https://inis.iaea.org/records/an804-p7682" ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "CAMS"@en ,
                                                                        "NPP ContainmentAtmosphericMonitoringSystem"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "the radiation monitoring equipment" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ContainmentAtmosphericMonitoringSystem"@en .

