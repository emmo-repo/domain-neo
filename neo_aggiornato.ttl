###  https://w3id.org/emmo/domain/neo#EmergencyResponseCentres
:EmergencyResponseCentres rdf:type owl:Class ;
                         rdfs:subClassOf :EmergencyManagementOrganization ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
