###  https://w3id.org/emmo/domain/neo#HeadVentNozzle
:HeadVentNozzle rdf:type owl:Class ;
                        rdfs:subClassOf :ReactorPreventiveSystems ,
                                        :PipePlantValve ,
                                        :ReactorBuildingContents ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty elite:isConstituentOf ;
                                          owl:someValuesFrom :ReactorPressureVessel
                                        ] ;
                        rdfs:comment "For depressurizing the reactor, the on-site ERC and the MRC staff decided to use the nitrogen operated head vent nozzle (a small valve at top of the RPV) as an alternative method to depressurize the reactor because DC power was available from the 250 V emergency batteries for this purpose."@en ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "HeadVentValve"@en ,
                                                                       "VentValve" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "It is a valve on the Reactor Pressure Vessel﻿"@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "HeadVentNozzle"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HeadVentNozzle ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "For depressurizing the reactor, the on-site ERC and the MRC staff decided to use the nitrogen operated head vent nozzle (a small valve at top of the RPV) as an alternative method to depressurize the reactor because DC power was available from the 250 V emergency batteries for this purpose."@en ;
   rdfs:seeAlso """Pag 124, The Fukushima Daiichi Accident Technical Volume 1/5 
link: https://www-pub.iaea.org/MTCD/Publications/PDF/AdditionalVolumes/P1710/Pub1710-TV1-Web.pdf"""
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HeadVentNozzle ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#altLabel> ;
   owl:annotatedTarget "VentValve" ;
   :referenceISO """device used to expel air from a compressed air system
https://www.iso.org/obp/ui/#iso:std:iso:24478:ed-1:v2:en:term:3.10.8.2"""^^xsd:anyURI
 ] .


