                         rdfs:subClassOf :Measurement ,
                                         :RadioactivityAssessment ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isConstitutiveProcessOf ;
                                           owl:someValuesFrom :SafetySensors
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "ContaminationMonitoring"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Measurement of dose or contamination for the purpose of the assessment or control of exposure to radiation or radioactive material, and the interpretation of the results." ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ContaminationMeasurement"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ContaminationMeasurement ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Measurement of dose or contamination for the purpose of the assessment or control of exposure to radiation or radioactive material, and the interpretation of the results." ;
   :referenceISO "https://www.iso.org/obp/ui/en/#iso:std:iso:20553:ed-1:v1:en:term:3.15"^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#RadiologicalContamination
:RadiologicalContamination rdf:type owl:Class ;
                         rdfs:subClassOf :UnintendedEvent ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:affects ;
                                           owl:someValuesFrom :PrimaryContainmentVessel
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:affects ;
                                           owl:someValuesFrom :TurbineBuildingContents
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:affects ;
                                           owl:someValuesFrom :NuclearPlantWorker
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:affects ;
                                           owl:someValuesFrom :ReactorBuildingContents
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Radioactive substances on surfaces, or within solids, liquids, or gases (including the human body), where their presence is unintended or undesirable, or the process giving rise to their presence in such places."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "RadiologicalContamination"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :RadiologicalContamination ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Radioactive substances on surfaces, or within solids, liquids, or gases (including the human body), where their presence is unintended or undesirable, or the process giving rise to their presence in such places."@en ;
   :referenceISO """ISO 12749-1:2020(en)
Nuclear energy — Vocabulary — Part 1: General terminology
https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-1:ed-1:v1:en"""^^xsd:anyURI
 ] .


