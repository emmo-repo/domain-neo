   :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:tr:27923:ed-1:v1:en:term:3.22>
 ] .


###  https://w3id.org/emmo/domain/neo#NuclearPlantAccident
:NuclearPlantAccident rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearEnergyProcess ;
                         rdfs:comment "Any accident involving facilities or activities from which a release of radioactive material occurs or is likely to occur and which has resulted or may result in an international significant transboundary release that could be of radiological safety significance for another State"@en ,
                                      "This is not explicitly stated to be a definition of nuclear accident, but it is derived from the statement of the scope of application in Article 1 of the Convention on Early Notification of a Nuclear Accident. However, this Convention has a limited scope of application, and it is unreasonable to consider a nuclear accident to be only an accident that results or may result in an international significant transboundary release"@en ;
                         rdfs:seeAlso <https://www-ns.iaea.org/downloads/standards/glossary/iaea-safety-glossary-draft-2016.pdf> ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Nuclear Plant Accident are any accident involving nuclear plant causing a radioactivity release. Depending on the magnitude of radioactive release there are different type of Nuclear Accident." ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "NuclearPlantAccident"@en .


###  https://w3id.org/emmo/domain/neo#ReactorContainmentSystem
:ReactorContainmentSystem rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorBuildingContents ,
                                         :ReactorMitigationSystem ;
                         rdfs:comment """1.On the IAEA report is called \"primary containment system\".

2.The Primary Containment consists of a drywell which encloses the reactor vessel and recirculation system, a pressure suppression chamber which stores a large volume of water, a connecting vent system between the drywell and the suppression chamber, isolation valves and containment atmosphere control systems. (https://www.nrc.gov/docs/ML1215/ML12159A162.pdf)"""@en ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "ReactorShieldCoolingSystem "@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "System constituted by a coherent set of physical barriers and/or auxiliary dynamic systems intended to confine radioactive substances in order to ensure the safety of the workers and the public and the protection of the environment ."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ReactorContainmentSystem"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ReactorContainmentSystem ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "System constituted by a coherent set of physical barriers and/or auxiliary dynamic systems intended to confine radioactive substances in order to ensure the safety of the workers and the public and the protection of the environment ."@en ;
   :referenceISO "https://www.iso.org/obp/ui/#iso:std:iso:17873:ed-1:v1:en"^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#SeismicallyIsolatedBuilding
:SeismicallyIsolatedBuilding rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearPowerPlantBuilding ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "SeismicallyIsolatedNuclearBuilding﻿"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "SeismicallyIsolatedBuilding"@en .


###  https://w3id.org/emmo/domain/neo#ReactorPressureVessel
:ReactorPressureVessel rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorBuildingContents ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :PrimaryContainmentVessel
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "RPV"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> """container designed primarily for the storage of pressurized fluid, which fulfils at least one of the following criteria:

    a) contains gas or liquid with high energy level;
    b) contains gas or liquid which will create a mishap (accident) if released;
    c) contains gas or liquid with high pressure level﻿"""@en ;
