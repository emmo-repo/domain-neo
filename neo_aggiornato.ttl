###  https://w3id.org/emmo/domain/neo#BackupPowerSystem
:BackupPowerSystem rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorProtectionSystem ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :NuclearPowerPlant
                                         ] ;
                         rdfs:comment "They flooded the primary and backup power systems and equipment, as well as the ultimate heat sink systems and structures, of all six units on the site"@en ;
                         rdfs:seeAlso """https://www-pub.iaea.org/MTCD/Publications/PDF/AdditionalVolumes/P1710/Pub1710-TV1-Web.pdf
The Fukushima Daiichi Accident Technical Volume 1/5
Pag 2""" ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "EmergencyPowerSupply" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "BackupPowerSystem"@en ;
                         :R8xx0dhbEh1tjGMDwNZfckV "It's a label used within the Fukushima report to represent the entire system used in case of an emergency to restore electrical power in a NuclearPowerPlant" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :BackupPowerSystem ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#altLabel> ;
   owl:annotatedTarget "EmergencyPowerSupply" ;
   rdfs:isDefinedBy """EmergencyPowerSupply is defined by:
https://www-pub.iaea.org/MTCD/Publications/PDF/Pub1188_web.pdf"""
 ] .


