###  https://w3id.org/emmo/domain/neo#HighPressureCoolantInjectionSystem
:HighPressureCoolantInjectionSystem rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorMitigationCoolingSystem ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :ContainmentBuilding
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "HPCI"@en ,
                                                                        "HighPressureEmergency CoreCoolingSystems"@en ,
                                                                        "ReactorHighPressureCoolantInjectionSystem"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "The high pressure coolant injection (HPCI) system is an independent emergency core cooling system requiring no auxiliary ac power, plant air systems, or external cooling water systems to perform its purpose of providing make up water to the reactor vessel for core cooling under small and intermediate size loss of coolant accidents. The high pressure coolant injection system can supply make up water to the reactor vessel from above rated reactor pressure to a reactor pressure below that at which the low pressure emergency core cooling systems can inject."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "HighPressureCoolantInjectionSystem"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HighPressureCoolantInjectionSystem ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "The high pressure coolant injection (HPCI) system is an independent emergency core cooling system requiring no auxiliary ac power, plant air systems, or external cooling water systems to perform its purpose of providing make up water to the reactor vessel for core cooling under small and intermediate size loss of coolant accidents. The high pressure coolant injection system can supply make up water to the reactor vessel from above rated reactor pressure to a reactor pressure below that at which the low pressure emergency core cooling systems can inject."@en ;
   :referenceNRC <https://www.nrc.gov/reading-rm/basic-ref/students/for-educators/03.pdf>
 ] .


