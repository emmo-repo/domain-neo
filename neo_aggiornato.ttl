:NuclearPowerPlantUnit rdf:type owl:Class ;
                        rdfs:subClassOf :NuclearEnergyObject ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty elite:isConstituentOf ;
                                          owl:someValuesFrom :NuclearPowerPlant
                                        ] ;
                        rdfs:comment "The NPP unit includes the nuclear reactor plus all its associated systems and buildings not shared by other nuclear reactors (ISO 12749-5:2018)"@en ;
                        rdfs:isDefinedBy "IAEA “Construction technologies for nuclear power plants”. IAEA Nuclear Energy Series No. NP-T-2.5. IAEA, Vienna, 2011. p. 190" ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "NPPUnit"@en ;
                        <http://www.w3.org/2004/02/skos/core#definition> "part of the NPP implementing NPP´s functions with the scope specified in the NPP´s design basis (ISO 12749-5:2018)"@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "NuclearPowerPlantUnit"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NuclearPowerPlantUnit ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "part of the NPP implementing NPP´s functions with the scope specified in the NPP´s design basis (ISO 12749-5:2018)"@en ;
   :referenceISO <https://www.iso.org/obp/ui/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.4.3>
 ] .


