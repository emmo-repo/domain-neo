###  https://w3id.org/emmo/domain/neo#ObjectFailure
:ObjectFailure rdf:type owl:Class ;
                         rdfs:subClassOf :UnintendedEvent ,
                                         :Damage ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:foregoes ;
                                           owl:someValuesFrom :HazardousNuclearEvent
                                         ] ;
                         rdfs:comment """An occurrence that results in a component’s loss of capability to
perform its intended safety functions.""" ;
                         rdfs:seeAlso <https://www.nrc.gov/docs/ML0707/ML070710376.pdf> ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "Failure"@en ,
                                                                        "SingleFailure" ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Loss of the ability of a structure, system or component to function within acceptance criteria. The structure, system or component is considered to fail when it becomes incapable of functioning, whether or not this is needed at that time. A failure may be the result of e.g. a hardware fault, a software fault, a system fault, an operator error or a maintenance error."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ObjectFailure"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ObjectFailure ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Loss of the ability of a structure, system or component to function within acceptance criteria. The structure, system or component is considered to fail when it becomes incapable of functioning, whether or not this is needed at that time. A failure may be the result of e.g. a hardware fault, a software fault, a system fault, an operator error or a maintenance error."@en ;
   :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/949.html"^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#UnintendedEvent
:UnintendedEvent rdf:type owl:Class ;
                         rdfs:subClassOf :Event ;
                         rdfs:comment "It is an event that can occur due to human error or the failure of artificial or industrial structures or phenomena."@en ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "UnexpectedEvent" ;
                         <http://www.w3.org/2004/02/skos/core#definition> "An unintended event is any casual occurrence, not controlled that can lead to hazardous condition to the surrounding environment where it takes place"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "UnintendedEvent"@en .


###  https://w3id.org/emmo/domain/neo#BoilingWaterReactor
