                                           owl:someValuesFrom :SCRAM
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:participatesTo ;
                                           owl:someValuesFrom :ControlRodInsertion
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "CR"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A rode/plate/tube that is used to absorb the neutrons in the reactor core. These help to control the number of fission events and thus the power of the nuclear reactor. "@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ControlRod"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ControlRod ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
