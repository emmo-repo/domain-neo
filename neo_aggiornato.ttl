   :referenceNRC "https://www.nrc.gov/docs/ML1125/ML11258A312.pdf"^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#BackwashValvePit
:BackwashValvePit rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorMitigationSystem ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :NuclearPowerPlant
                                         ] ;
                         rdfs:comment "A water injection line was installed by connecting 3 fire engines in series and using the Unit 3 reverse cleaning valve pit as water source, to start seawater injection to Unit 1 at 19:04."@en ,
                                      "The Site Superintendent then decided to inject seawater into the Unit 1 reactor from the Unit 3 backwash valve pit, where seawater had pooled after the tsunami, as it was the only available source of water at that time."@en ;
                         rdfs:seeAlso <https://fdada.info/develop/docs/pdf/ES-Unit123-04.pdf> ,
                                      """Pag 21, The Fukushima Daiichi Accident Technical Volume 1/5 
link: https://www-pub.iaea.org/MTCD/Publications/PDF/AdditionalVolumes/P1710/Pub1710-TV1-Web.pdf"""@en ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "ReverseCleaningValvePit"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "place where valves are installed to reverse the current of seawater" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "BackwashValvePit"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :BackwashValvePit ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "place where valves are installed to reverse the current of seawater" ;
   rdfs:isDefinedBy "https://www.proz.com/kudoz/english/nuclear-eng-sci/6121004-backwash-valve-pit.html"
 ] .


