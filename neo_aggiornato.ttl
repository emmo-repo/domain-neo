:ReactorCoreEnergyProduction rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearEnergyProcess ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty [ owl:inverseOf elite:isSubProcessOf
                                                          ] ;
                                           owl:someValuesFrom :NuclearChainReaction
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#definition> "The process for producing energy from nuclear sources, in a reactor core of a nuclear power plant."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ReactorCoreEnergyProduction"@en .


###  https://w3id.org/emmo/domain/neo#ResidualHeatRemovalSystem
:ResidualHeatRemovalSystem rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorPreventiveSystems ,
                                         :ReactorBuildingContents ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isInputOf ;
                                           owl:someValuesFrom :RHROperation
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :ContainmentBuilding
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "DecayHeatRemovalSystem"@en ,
                                                                        "RHR"@en ,
                                                                        "ReactorResidualHeatRemovalSystem"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Heat is removed during normal power operation by generating steam in the reactor vessel and then using that steam to generate electrical energy. When the reactor is shutdown, the core will still continue to generate decay heat. The heat is removed by bypassing the turbine and dumping the steam directly to the condenser. The shutdown cooling mode of the residual heat removal (RHR) system is used to complete the cooldown process when pressure decreases to approximately 50 psig. Water is pumped from the reactor recirculation loop through a heat exchanger and back to the reactor via the recirculation loop. The recirculation loop is used to limit the number of penetrations into the reactor vessel."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ResidualHeatRemovalSystem"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ResidualHeatRemovalSystem ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Heat is removed during normal power operation by generating steam in the reactor vessel and then using that steam to generate electrical energy. When the reactor is shutdown, the core will still continue to generate decay heat. The heat is removed by bypassing the turbine and dumping the steam directly to the condenser. The shutdown cooling mode of the residual heat removal (RHR) system is used to complete the cooldown process when pressure decreases to approximately 50 psig. Water is pumped from the reactor recirculation loop through a heat exchanger and back to the reactor via the recirculation loop. The recirculation loop is used to limit the number of penetrations into the reactor vessel."@en ;
   :referenceNRC <https://www.nrc.gov/docs/ML1209/ML120970422.pdf>
 ] .


###  https://w3id.org/emmo/domain/neo#MainAdminstratorBuilding
:MainAdminstratorBuilding rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearPowerPlantBuilding ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "MainReactorAdminstratorBuilding" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "MainAdminstratorBuilding"@en .


###  https://w3id.org/emmo/domain/neo#FireEngine
:FireEngine rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorMitigationSystem ,
                                         :WaterInjectionSystem ;
                         rdfs:comment "This report outlines the use of fire engines in an attempt to inject water into the reactors at Fukushima Daiichi. After the tsunami, much of the cooling function on-site was lost. The slides below document what fire engines were on site at what time, and what sources of water were injected where. Later research shows that little of the injected water made it to the reactors due to the lack of backflow valves in the fire line systems"@en ;
                         rdfs:seeAlso <https://fdada.info/develop/docs/pdf/ES-Unit123-04.pdf> ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "NPPFireEngine"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A fire engine or fire truck (also spelled firetruck) is a vehicle, usually a specially-designed or modified truck, that functions as a firefighting apparatus." ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "FireEngine"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :FireEngine ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "A fire engine or fire truck (also spelled firetruck) is a vehicle, usually a specially-designed or modified truck, that functions as a firefighting apparatus." ;
   rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Fire_engine"
 ] .


###  https://w3id.org/emmo/domain/neo#Neutron
:Neutron rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/emmo/hume#PhysicalParticle> ;
                         <http://www.w3.org/2004/02/skos/core#definition> """subatomic particles used for neutron imaging (3.41) (NI) purposes by the neutron attenuation process in a similar fashion to X-rays (3.76)
Note 1 to entry: Neutron imaging can be used to detect changes in hydrogen abundance that can be correlated with the post-mortem (3.57) interval, i.e. the time that has elapsed since a person has died."""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Neutron"@en ;
                         :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso-iec:39794:-16:ed-1:v1:en:term:3.52> .


###  https://w3id.org/emmo/domain/neo#StandbyGasTreatmentSystem
:StandbyGasTreatmentSystem rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorMitigationSystem ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :ContainmentBuilding
                                         ] ;
                         rdfs:comment "The RB surrounds the primary containment and provides the second fission product barrier and is commonly called as secondary containment. In case of an accident, the standby gas treatment system (SGTS), which needs AC power for operation, filters the gases and keeps the inside pressure below the atmospheric pressure to prevent radioactive materials release."@en ;
                         rdfs:seeAlso <https://www.tepco.co.jp/en/nu/fukushima-np/images/handouts_110827_02-e.pdf> ,
                                      """pag 74,The Fukushima Daiichi Accident Technical Volume 1/5 
link: https://www-pub.iaea.org/MTCD/Publications/PDF/AdditionalVolumes/P1710/Pub1710-TV1-Web.pdf""" ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "EmergencyGasTreatmentSystem"@en ,
                                                                        "ReactorStandbyGasTreatmentSystem"@en ,
                                                                        "SGTS"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "The Standby Gas Treatment system processes exhaust air from the secondary containment under accident conditions to limit radiation dose rates to less than 10 CFR 100 limits. The Standby Gas Treatment system is also used to purge the primary containment and leak test the secondary containment." ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "StandbyGasTreatmentSystem"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :StandbyGasTreatmentSystem ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "The Standby Gas Treatment system processes exhaust air from the secondary containment under accident conditions to limit radiation dose rates to less than 10 CFR 100 limits. The Standby Gas Treatment system is also used to purge the primary containment and leak test the secondary containment." ;
   :referenceNRC "https://www.nrc.gov/docs/ML1215/ML12159A162.pdf"^^xsd:anyURI
 ] .


