###  https://w3id.org/emmo/domain/neo#SuppressionChamber
:SuppressionChamber rdf:type owl:Class ;
                        rdfs:subClassOf :ReactorBuildingContents ,
                                        :ReactorMitigationSystem ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                          owl:someValuesFrom :PrimaryContainmentVessel
                                        ] ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "ReactorSuppressionChamber"@en ,
                                                                       "SC"@en ,
                                                                       "SuppressionPool" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "The suppression chamber consists of a steel pressure vessel with a toroidal shape (sometimes referred to as torus) and a large body of water inside the suppression chamber (referred to as the suppression pool). The purposes of the suppression chamber are to condense steam released from a LOCA and to prevent radioactive materials from passing through this portion of the primary containment boundary.  ﻿"@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "SuppressionChamber"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :SuppressionChamber ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "The suppression chamber consists of a steel pressure vessel with a toroidal shape (sometimes referred to as torus) and a large body of water inside the suppression chamber (referred to as the suppression pool). The purposes of the suppression chamber are to condense steam released from a LOCA and to prevent radioactive materials from passing through this portion of the primary containment boundary.  ﻿"@en ;
   :referenceNRC <https://www.nrc.gov/docs/ML1215/ML12159A162.pdf>
 ] .


###  https://w3id.org/emmo/domain/neo#NuclearAccidentIntermediateEvent
:NuclearAccidentIntermediateEvent rdf:type owl:Class ;
                        rdfs:subClassOf :HazardousNuclearEvent ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty elite:foregoes ;
                                          owl:someValuesFrom :NuclearAccidentFinalEvent
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty elite:isStageOf ;
                                          owl:someValuesFrom :NuclearPlantAccident
                                        ] ;
                        <http://www.w3.org/2004/02/skos/core#definition> "It is any event, in temporary order, between the initial and the final event of the sequence of the events in a nuclear accident" ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "NuclearAccidentIntermediateEvent"@en .


