                         <http://www.w3.org/2004/02/skos/core#definition> "Any person who works, whether full time, part time or temporarily, for an employer and who has recognized rights and duties in relation to occupational radiation protection."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "NuclearPlantWorker"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NuclearPlantWorker ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Any person who works, whether full time, part time or temporarily, for an employer and who has recognized rights and duties in relation to occupational radiation protection."@en ;
   :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/236.html"^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#ComponentFailure
:ComponentFailure rdf:type owl:Class ;
                         rdfs:subClassOf :ObjectFailure ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Loss of the ability of a component to function within acceptance criteria. The component is considered to fail when it becomes incapable of functioning, whether or not this is needed at that time."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ComponentFailure"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ComponentFailure ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Loss of the ability of a component to function within acceptance criteria. The component is considered to fail when it becomes incapable of functioning, whether or not this is needed at that time."@en ;
   :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/949"^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#SpentFuelPool
:SpentFuelPool rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorBuildingContents ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :CommonSpentFuelBuilding
                                         ] ;
                         rdfs:comment "Spent fuel pools (SFP) are storage pools for spent fuel from nuclear reactors. They are typically 40 or more feet (12 m) deep, with the bottom 14 feet (4.3 m) equipped with storage racks designed to hold fuel assemblies removed from reactors. A reactor's local pool is specially designed for the reactor in which the fuel was used and is situated at the reactor site. Such pools are used for short-term cooling of the fuel rods. This allows short-lived isotopes to decay and thus reduces the ionizing radiation and decay heat emanating from the rods. The water cools the fuel and provides radiological protection from its radiation."@en ;
                         rdfs:isDefinedBy <https://en.wikipedia.org/wiki/Spent_fuel_pool> ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "SFP"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "SpentFuelPool"@en .


###  https://w3id.org/emmo/domain/neo#CoreMeltdown
:CoreMeltdown rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearSevereAccident ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isSubProcessOf ;
                                           owl:someValuesFrom :CoreMeltdown
                                         ] ;
                         rdfs:isDefinedBy <https://www.eionet.europa.eu/gemet/en/concept/1799> ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "NuclearMeltdown"@en ,
                                                                        "PartialCoreMeltdown"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "An accidental overheating of the part of the nuclear reactor where fission takes place, causing fuel elements and other parts of the reactor to melt, potentially leading to catastrophic consequences in which dangerous levels of radioactive materials would be released into the environment."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "CoreMeltdown"@en .


###  https://w3id.org/emmo/domain/neo#ReactorBuildingContents
:ReactorBuildingContents rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearEnergyObject ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isConstituentOf ;
                                           owl:someValuesFrom :BoilingWaterReactor
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :ContainmentBuilding
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "buildingElement" ;
                         <http://www.w3.org/2004/02/skos/core#comment> "Elements that are contained in a Reactor Building"@en ,
                                                                       """They are distinguished from elements as integral part of a built environment
Note 1 to entry: This includes floors, walls, beams, columns, doors, and penetrations, but does not include contents."""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ReactorBuildingContents"@en ;
                         :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:24679:-1:ed-1:v1:en:term:3.1> .


###  https://w3id.org/emmo/domain/neo#NPPNormalOperation
:NPPNormalOperation rdf:type owl:Class ;
                         rdfs:subClassOf :DefenceinDepthProcedures ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isConstitutiveProcessOf ;
                                           owl:someValuesFrom :Nuclear_Reactor
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isConstitutiveProcessOf ;
                                           owl:someValuesFrom :NuclearPowerPlant
                                         ] ;
                         rdfs:comment "Level 1 of Defense in depth: Plant control under normal conditions"@en ,
                                      "StandardOperatingProcedures (SOP)"@en ,
                                      """The prevention of system failures and deviations from normal operations. This is a continuous and largely
repetitive process. The algorithms used are very different from those of protection functions, and experience
with the system functionality may be gained in every clock cycle. Also, the potential development of
undetected failures can be lower."""@en ,
                                      "there are not failures in the plant"@en ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "NPPPreventiveOperation"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Operation within specified operational limits and conditions. This includes startup, power operation, shutting down, shutdown, maintenance, testing and refuelling"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "NPPNormalOperation"@en ;
                         :RR3uD2d7YfhHohfv2Nm6sX "No off-site radiological impact (bounded by regulatory operating limits for discharge)"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NPPNormalOperation ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Operation within specified operational limits and conditions. This includes startup, power operation, shutting down, shutdown, maintenance, testing and refuelling"@en ;
   rdfs:seeAlso """Approaches for Overall Instrumentation and Control Architectures of Nuclear Power Plants, IAEA Nuclear Energy Series No. NP-T-2.11, IAEA, Vienna (2018)
https://www-pub.iaea.org/MTCD/Publications/PDF/PUB1821_web.pdf""" ;
   :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/597.html"^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#ControlOfDeviations
:ControlOfDeviations rdf:type owl:Class ;
                         rdfs:subClassOf :Controlling ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "Level2DiD" ;
                         <http://www.w3.org/2004/02/skos/core#definition> """Control of deviations from normal operating states to prevent anticipated operational occurrences from
escalating to accident conditions. This can be provided both by electronic means and by operator intervention,
if there is enough time and information for such actions to be credited. The algorithms used are different
from control."""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ControlOfDeviations"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ControlOfDeviations ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """Control of deviations from normal operating states to prevent anticipated operational occurrences from
escalating to accident conditions. This can be provided both by electronic means and by operator intervention,
if there is enough time and information for such actions to be credited. The algorithms used are different
from control."""@en ;
   rdfs:isDefinedBy """Approaches for Overall Instrumentation and Control Architectures of Nuclear Power Plants, IAEA Nuclear Energy Series No. NP-T-2.11, IAEA, Vienna (2018) p.12
https://www-pub.iaea.org/MTCD/Publications/PDF/PUB1821_web.pdf"""
 ] .


