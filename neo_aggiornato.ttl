###  https://w3id.org/emmo/domain/neo#RCICTurbine
:RCICTurbine rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorProtectionSystem ,
                                         :PlantTurbine ,
                                         :ReactorBuildingContents ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isConstituentOf ;
                                           owl:someValuesFrom :ReactorCoreIsolationCoolingSystem
                                         ] ;
                         rdfs:comment "It's inside th RCIC"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "The RCIC turbine is designed to rapidly accelerate from standby to the full load condition within 30 seconds. The RCIC turbine is a horizontally mounted radial re-entry, non-condensing Terry turbine. The RCIC turbine is designed to operate with a steam supply pressure ranging from 150 to 1135 psig. The RCIC turbine exhausts to the suppression pool under water."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "RCICTurbine"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :RCICTurbine ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "The RCIC turbine is designed to rapidly accelerate from standby to the full load condition within 30 seconds. The RCIC turbine is a horizontally mounted radial re-entry, non-condensing Terry turbine. The RCIC turbine is designed to operate with a steam supply pressure ranging from 150 to 1135 psig. The RCIC turbine exhausts to the suppression pool under water."@en ;
   :referenceNRC "https://www.nrc.gov/docs/ML1125/ML11258A311.pdf"^^xsd:anyURI
 ] .


