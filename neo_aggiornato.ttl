###  https://w3id.org/emmo/domain/neo#ControlRodGroup
:ControlRodGroup rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorBuildingContents ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:participatesTo ;
                                           owl:someValuesFrom :NPPStartUpPhase
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:participatesTo ;
                                           owl:someValuesFrom :SCRAM
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:participatesTo ;
                                           owl:someValuesFrom :ControlRodInsertion
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :ReactorPressureVessel
                                         ] ;
                         rdfs:comment "Check definition" ;
                         <http://www.w3.org/2004/02/skos/core#definition> """One or more rods that are inserted or withdrawn simultaneously 

Note 1 to entry: The term “all control rod groups” means all safety and regulating control rod groups. This term may also be shortened to simply “rod group.” 

Note 2 to entry: Some utilities use the term \"bank\" instead of \"group\". A control rod bank is the same as a control rod group."""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ControlRodGroup"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ControlRodGroup ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """One or more rods that are inserted or withdrawn simultaneously 

Note 1 to entry: The term “all control rod groups” means all safety and regulating control rod groups. This term may also be shortened to simply “rod group.” 

Note 2 to entry: Some utilities use the term \"bank\" instead of \"group\". A control rod bank is the same as a control rod group."""@en ;
   :referenceISO "ISO 18077:2022(en) Reload startup physics tests for pressurized water reactors."^^xsd:anyURI
 ] .


