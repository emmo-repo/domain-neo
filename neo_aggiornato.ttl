###  https://w3id.org/emmo/domain/neo#ReactorCoreIsolationCoolingSystem
:ReactorCoreIsolationCoolingSystem rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorProtectionSystem ,
                                         :ReactorBuildingContents ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :ContainmentBuilding
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "RCIC"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "The reactor core isolation cooling (RCIC) system provides makeup water to the reactor vessel for core cooling when the main steam lines are isolated and the normal supply of water to the reactor vessel is lost. The RCIC system consists of a turbine-driven pump, piping, and valves necessary to deliver water to the reactor vessel at operating conditions. "@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ReactorCoreIsolationCoolingSystem"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ReactorCoreIsolationCoolingSystem ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "The reactor core isolation cooling (RCIC) system provides makeup water to the reactor vessel for core cooling when the main steam lines are isolated and the normal supply of water to the reactor vessel is lost. The RCIC system consists of a turbine-driven pump, piping, and valves necessary to deliver water to the reactor vessel at operating conditions. "@en ;
   :referenceNRC <https://www.nrc.gov/docs/ML1209/ML120970422.pdf>
 ] .


###  https://w3id.org/emmo/domain/neo#NuclearReaction
:NuclearReaction rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/emmo/hume#PhysicalPhenomenon> ;
                         <http://www.w3.org/2004/02/skos/core#definition> "In nuclear physics and nuclear chemistry, a nuclear reaction is a process in which two nuclei, or a nucleus and an external subatomic particle, collide to produce one or more new nuclides. Thus, a nuclear reaction must cause a transformation of at least one nuclide to another."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "NuclearReaction"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NuclearReaction ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "In nuclear physics and nuclear chemistry, a nuclear reaction is a process in which two nuclei, or a nucleus and an external subatomic particle, collide to produce one or more new nuclides. Thus, a nuclear reaction must cause a transformation of at least one nuclide to another."@en ;
   rdfs:isDefinedBy <https://en.wikipedia.org/wiki/Nuclear_reaction>
 ] .


###  https://w3id.org/emmo/domain/neo#ThermalNeutron
:ThermalNeutron rdf:type owl:Class ;
                         rdfs:subClassOf :Neutron ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isInputOf ;
                                           owl:someValuesFrom :ThermalInducedFission
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isOutputOf ;
                                           owl:someValuesFrom :NuclearChainReaction
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "Neutron that has, by collision with other particles, reached an energy state equal to that of its surroundings."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ThermalNeutron"@en ;
                         :referenceISO "ISO 12749-5:2018(en) Nuclear energy, nuclear technologies, and radiological protection — Vocabulary — Part 5: Nuclear reactors"^^xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#SteamCondenser
:SteamCondenser rdf:type owl:Class ;
