   owl:annotatedTarget <https://www.nra.go.jp/data/000292313.pdf> ;
   rdfs:seeAlso <https://w3id.org/emmo/domain/neo>
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ContainmentAtmosphericMonitoringSystem ;
