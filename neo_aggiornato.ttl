###  https://w3id.org/emmo/domain/neo#PostulatedInitiatingEvent
:PostulatedInitiatingEvent rdf:type owl:Class ;
                        rdfs:subClassOf :HazardousNuclearEvent ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty elite:foregoes ;
                                          owl:someValuesFrom :AOOControl
                                        ] ;
                        <http://www.w3.org/2004/02/skos/core#definition> """A PIE Is an event identified in the
design that leads to Anticipated Operational Occurrences (AOOs) or accident conditions. Accident
conditions include Design Basis Accidents (DBAs) and Beyond Design Basis Accidents (BDBAs). BDBAs
include a subset of severe accidents."""@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "PostulatedInitiatingEvent"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :PostulatedInitiatingEvent ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """A PIE Is an event identified in the
design that leads to Anticipated Operational Occurrences (AOOs) or accident conditions. Accident
conditions include Design Basis Accidents (DBAs) and Beyond Design Basis Accidents (BDBAs). BDBAs
include a subset of severe accidents."""@en ;
   :referenceNRC <https://www.nrc.gov/docs/ML2031/ML20318A171.pdf>
 ] .


###  https://w3id.org/emmo/domain/neo#ShelterInPlace
