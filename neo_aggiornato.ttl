###  https://w3id.org/emmo/domain/neo#PipePlantValve
:PipePlantValve rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearEnergyObject ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:hasBehaviour ;
                                           owl:someValuesFrom :Switching
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "Valve" ;
                         <http://www.w3.org/2004/02/skos/core#definition> """device consisting essentially of a valve body, closure member, and actuator that controls the flow of gas
Note 1 to entry: The actuation can be done by gas pressure, electrical, hydraulic, manual or pneumatic energy."""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "PipePlantValve"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :PipePlantValve ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """device consisting essentially of a valve body, closure member, and actuator that controls the flow of gas
Note 1 to entry: The actuation can be done by gas pressure, electrical, hydraulic, manual or pneumatic energy."""@en ;
   :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:23551:-1:ed-2:v1:en:term:3.101.1>
 ] .


###  https://w3id.org/emmo/domain/neo#NuclearAccidentInitiatingEvent
:NuclearAccidentInitiatingEvent rdf:type owl:Class ;
                         rdfs:subClassOf :NPPUnintendedEvent ,
                                         :PostulatedInitiatingEvent ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:foregoes ;
                                           owl:someValuesFrom :NuclearPlantAccident
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "InitiatingEvent"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "An event that creates a disturbance. in the plant and has a potential to lead to core damage, depending on the successful operation of the various mitigating systems of the plant"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "NuclearAccidentInitiatingEvent"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NuclearAccidentInitiatingEvent ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "An event that creates a disturbance. in the plant and has a potential to lead to core damage, depending on the successful operation of the various mitigating systems of the plant"@en ;
   rdfs:seeAlso """All the events that can lead to the degradation of the core:
http://www-ns.iaea.org/downloads/ni/training/specific_expert_knowledge/psa-level1/III1_1_A%20%20Initiating%20Event%20Analysis.pdf"""
 ] .


###  https://w3id.org/emmo/domain/neo#MultipleUnitNuclearPowerPlant
:MultipleUnitNuclearPowerPlant rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearPowerPlant ;
                         rdfs:comment "The nuclear reactors and the electric production lines can be either almost identical or different between them, though usually sharing various support or auxiliary installations, systems and/or supplies (ISO 12749-5:2018)"@en ,
                                      "change the order" ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "MultipleUnitNPP"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Nuclear power plant  having on a common site, two or more electric production lines (ISO 12749-5:2018)"@en ;
                         <http://www.w3.org/2004/02/skos/core#example> "Tennessee Valley Authority Browns Ferry Nuclear Plant (Athens, Alabama, United States)"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "MultipleUnitNuclearPowerPlant"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :MultipleUnitNuclearPowerPlant ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
