                        <http://www.w3.org/2004/02/skos/core#prefLabel> "PostulatedAccident"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :PostulatedAccident ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """Unanticipated conditions of operation (i.e., not expected to occur
during the life of the nuclear power unit).
Postulated accidents are also known as Condition IV events.""" ;
   :referenceNRC "https://www.nrc.gov/docs/ML0707/ML070710376.pdf"^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#LossOfDCPower
:LossOfDCPower rdf:type owl:Class ;
                        rdfs:subClassOf :NPPPowerLoss ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty elite:isBehaviourOf ;
                                          owl:someValuesFrom :DCOperationalPowerSource
                                        ] ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Loss of those devices like batteries and solar panel that during SBO conditions are required to power a minimum set of critical equipment important to safety, as well as critical instrumentation for monitoring of plant parameters, and emergency lighting"@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "LossOfDCPower"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :LossOfDCPower ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Loss of those devices like batteries and solar panel that during SBO conditions are required to power a minimum set of critical equipment important to safety, as well as critical instrumentation for monitoring of plant parameters, and emergency lighting"@en ;
   rdfs:isDefinedBy "https://www-pub.iaea.org/MTCD/Publications/PDF/TE-1770_web.pdf"
 ] .


###  https://w3id.org/emmo/domain/neo#NaturallyRadioactiveMaterial
:NaturallyRadioactiveMaterial rdf:type owl:Class ;
                        rdfs:subClassOf :RadioactiveMaterialByOccurrence ;
                        rdfs:comment """The exact definition of ‘significant amounts’ would be a regulatory decision.
Material in which the activity concentrations of the naturally occurring radionuclides have been changed by a process is included in naturally occurring radioactive material (NORM).
 Naturally occurring radioactive material or NORM should be used in the singular unless reference is explicitly being made to various materials."""@en ;
                        rdfs:isDefinedBy """IAEA Safety Glossary, Terminology Used in Nuclear Safety 
and Radiation Protection, 2018 Edition """ ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Radioactive material containing no significant amounts of radionuclides other than naturally occurring radionuclides.﻿"@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "NaturallyRadioactiveMaterial"@en .


