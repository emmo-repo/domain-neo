:ContinuosInjection rdf:type owl:Class ;
                         rdfs:subClassOf :RegularInjection ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ContinuosInjection"@en .


###  https://w3id.org/emmo/domain/neo#HazardousNuclearEvent
:HazardousNuclearEvent rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearEnergyProcess ;
                         rdfs:seeAlso <http://www-ns.iaea.org/downloads/ni/training/specific_expert_knowledge/psa-level1/III1_1_A%20%20Initiating%20Event%20Analysis.pdf> ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "NuclearPlantAccidentEvents"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "An event that creates disturbance in a Nuclear Reactor Plant Management and that leads to hazardous condition to the surrounding environment where it takes place"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "HazardousNuclearEvent"@en .


###  https://w3id.org/emmo/domain/neo#NuclearFission
:NuclearFission rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearReaction ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isConstitutiveProcessOf ;
                                           owl:someValuesFrom :FuelAssembly
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isConstitutiveProcessOf ;
                                           owl:someValuesFrom :FuelElement
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty [ owl:inverseOf elite:isOutputOf
                                                          ] ;
                                           owl:someValuesFrom :FissionProduct
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#definition> """splitting of a nucleus into fission fragments, either spontaneously or as a result of the impact of a particle, usually with an associated release of energy
Note 1 to entry: The nucleus usually has a high mass number, together with an intermediate or low average-binding-energy-per-nucleon; hence, an inherent instability exists, and the fission fragments are usually highly unstable.
[SOURCE: ISO 12749‑5:2018, 3.1.1]"""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "NuclearFission"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NuclearFission ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """splitting of a nucleus into fission fragments, either spontaneously or as a result of the impact of a particle, usually with an associated release of energy
Note 1 to entry: The nucleus usually has a high mass number, together with an intermediate or low average-binding-energy-per-nucleon; hence, an inherent instability exists, and the fission fragments are usually highly unstable.
[SOURCE: ISO 12749‑5:2018, 3.1.1]"""@en ;
   :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-1:ed-1:v1:en:term:3.2.2>
 ] .


###  https://w3id.org/emmo/domain/neo#SCRAM
:SCRAM rdf:type owl:Class ;
                         rdfs:subClassOf :NPPProtection ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isStageOf ;
                                           owl:someValuesFrom :NPPShutdown
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isSubProcessOf ;
                                           owl:someValuesFrom :SevereAccidentManagement
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "ReactorTrip"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "The sudden shutting down of a nuclear reactor, usually by rapid insertion of control rods, either automatically or manually by the reactor operator. Also known as a \"reactor trip\""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "SCRAM"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :SCRAM ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "The sudden shutting down of a nuclear reactor, usually by rapid insertion of control rods, either automatically or manually by the reactor operator. Also known as a \"reactor trip\""@en ;
   :referenceNRC <https://www.nrc.gov/reading-rm/basic-ref/glossary/scram.html>
 ] .


