   :referenceARIS <https://aris.iaea.org/Glossary>
 ] .


###  https://w3id.org/emmo/domain/neo#TurbineValve
:TurbineValve rdf:type owl:Class ;
                         rdfs:subClassOf :TurbineBuildingContents ,
                                         :PipePlantValve ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :TurbineBuilding
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "NuclearTurbineValve"@en ,
                                                                        "StopValve"@en ;
                         <http://www.w3.org/2004/02/skos/core#comment> "The main turbine is an 1800 rpm, tandem compound machine consisting of one high-pressure turbine and three lowpressure turbines. The steam enters the middle of the high-pressure section and works its way toward each end, dissipating its energy to the turbine blades which are attached to a common shaft. Steam exiting the high-pressure turbine passes through moisture separators where entrained moisture, which could damage the turbine blades, is removed prior to entering the low-pressure turbine (BWR description)"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "TurbineValve"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :TurbineValve ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#comment> ;
   owl:annotatedTarget "The main turbine is an 1800 rpm, tandem compound machine consisting of one high-pressure turbine and three lowpressure turbines. The steam enters the middle of the high-pressure section and works its way toward each end, dissipating its energy to the turbine blades which are attached to a common shaft. Steam exiting the high-pressure turbine passes through moisture separators where entrained moisture, which could damage the turbine blades, is removed prior to entering the low-pressure turbine (BWR description)"@en ;
   :referenceINIS "https://inis.iaea.org/collection/NCLCollectionStore/_Public/27/051/27051618.pdf"
 ] .


