###  https://w3id.org/emmo/domain/neo#NPPActivationProduct
:NPPActivationProduct rdf:type owl:Class ;
                         rdfs:subClassOf :ArtificialRadioactiveMaterial ,
                                         :ReactorCoreMaterial ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isConstituentOf ;
                                           owl:someValuesFrom :ReactorCore
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isOutputOf ;
                                           owl:someValuesFrom :NuclearReaction
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isOutputOf ;
                                           owl:someValuesFrom :SystemStarting
                                         ] ;
                         rdfs:comment "Fission products and actinides produced by neutron absorption of nuclear fuel itself are normally referred to by those specific names, and activation product reserved for products of neutron capture by other materials, such as structural components of the nuclear reactor or nuclear bomb, the reactor coolant, control rods or other neutron poisons, or materials in the environment. All of these, however, need to be handled as radioactive waste. Some nuclides originate in more than one way, as activation products or fission products."@en ;
                         rdfs:seeAlso <https://en.wikipedia.org/wiki/Activation_product> ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "NPPActivationProduct"@en .


###  https://w3id.org/emmo/domain/neo#SafetySystem
:SafetySystem rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearEnergyObject ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isConstituentOf ;
                                           owl:someValuesFrom :NuclearPowerPlant
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:participatesTo ;
                                           owl:someValuesFrom :NPPProtection
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "SafetyElements"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> """system including the safety devices and the interconnections between the equipment to be protected and any discharge connection to the nearest location of a safe disposal place
Note 1 to entry: This location can either be an atmospheric outlet or the connection into a safe collecting system or flare."""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "SafetySystem"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :SafetySystem ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """system including the safety devices and the interconnections between the equipment to be protected and any discharge connection to the nearest location of a safe disposal place
Note 1 to entry: This location can either be an atmospheric outlet or the connection into a safe collecting system or flare."""@en ;
   :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:4126:-9:ed-1:v1:en:term:3.2>
 ] .


###  https://w3id.org/emmo/domain/neo#LowPressureEmergencyCoreCoolingSystems
:LowPressureEmergencyCoreCoolingSystems rdf:type owl:Class ;
                         rdfs:subClassOf :ReactorMitigationCoolingSystem ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :ContainmentBuilding
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "LPECCS" ;
                         <http://www.w3.org/2004/02/skos/core#definition> """The low pressure emergency core cooling systems consist of two separate and independent systems, the core spray system and the low pressure coolant injection (LPCI) mode of the residual heat removal system. The core spray system consists of two separate and independent pumping loops, each capable of pumping water from the suppression pool into the reactor vessel. Core cooling is accomplished by spraying water on top of the fuel assemblies.
The low pressure coolant injection mode of the residual heat removal system provides makeup water to the reactor vessel for core cooling under loss of coolant accident conditions. The residual heat removal system is a multipurpose system with several operational modes, each utilizing the same major pieces of equipment. The low pressure coolant injection mode is the dominant mode and normal valve lineup configuration of the residual heat removal system. The low pressure coolant injection mode operates automatically to restore and, if necessary, maintain the reactor vessel coolant inventory to preclude fuel cladding temperatures in excess of 2200EF. During low pressure coolant injection operation, the residual heat removal pumps take water from the suppression pool and discharge to the reactor vessel."""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "LowPressureEmergencyCoreCoolingSystems"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :LowPressureEmergencyCoreCoolingSystems ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """The low pressure emergency core cooling systems consist of two separate and independent systems, the core spray system and the low pressure coolant injection (LPCI) mode of the residual heat removal system. The core spray system consists of two separate and independent pumping loops, each capable of pumping water from the suppression pool into the reactor vessel. Core cooling is accomplished by spraying water on top of the fuel assemblies.
The low pressure coolant injection mode of the residual heat removal system provides makeup water to the reactor vessel for core cooling under loss of coolant accident conditions. The residual heat removal system is a multipurpose system with several operational modes, each utilizing the same major pieces of equipment. The low pressure coolant injection mode is the dominant mode and normal valve lineup configuration of the residual heat removal system. The low pressure coolant injection mode operates automatically to restore and, if necessary, maintain the reactor vessel coolant inventory to preclude fuel cladding temperatures in excess of 2200EF. During low pressure coolant injection operation, the residual heat removal pumps take water from the suppression pool and discharge to the reactor vessel."""@en ;
   :referenceNRC <https://www.nrc.gov/docs/ML1209/ML120970422.pdf>
 ] .


###  https://w3id.org/emmo/domain/neo#NeutronInducedFission
:NeutronInducedFission rdf:type owl:Class ;
                         rdfs:subClassOf :NuclearFission ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:isStageOf ;
                                           owl:someValuesFrom :NuclearChainReaction
                                         ] ;
                         <http://www.w3.org/2004/02/skos/core#definition> """nuclear fission (3.1.1) initiated by a nucleus when an external colliding particle is absorbed
Note 1 to entry: The absorption of the external colliding particle, usually a neutron, generates a strong increase in the compound nucleus internal energy and, hence, increases the compound nucleus instability, favouring a large energy release by means of a nucleus partition."""@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "NeutronInducedFission"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :NeutronInducedFission ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """nuclear fission (3.1.1) initiated by a nucleus when an external colliding particle is absorbed
Note 1 to entry: The absorption of the external colliding particle, usually a neutron, generates a strong increase in the compound nucleus internal energy and, hence, increases the compound nucleus instability, favouring a large energy release by means of a nucleus partition."""@en ;
   :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.1.1.1>
 ] .


###  https://w3id.org/emmo/domain/neo#MobileRadiationMonitor
:MobileRadiationMonitor rdf:type owl:Class ;
                         rdfs:subClassOf :SafetySystem ,
                                         :SafetySensors ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty elite:participatesTo ;
                                           owl:someValuesFrom :RadiologicalContamination
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :RB4rNlczhggIx7lqdEK2d9c ;
                                           owl:someValuesFrom :NuclearPowerPlant
                                         ] ;
                         rdfs:comment """Meanwhile, an attempt to enter the Unit 1 RB to conduct radiation measurements at 03:45 on 12 March was abandoned, when the team encountered white fog-like steam upon opening the airlock
door, although the measurements at the radiation monitoring post near the site’s main gate did not show any anomaly to indicate a release from RPV or PCV at 04:00."""@en ;
                         rdfs:seeAlso """https://www-pub.iaea.org/MTCD/Publications/PDF/AdditionalVolumes/P1710/Pub1710-TV1-Web.pdf
The Fukushima Daiichi Accident Technical Volume 1/5 
Pag 29""" ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A Radiation Monitor is a device used to detect and measure radiation fields in the vicinity of a radiation source, evaluate radiation contamination of patients, equipment, or the environment, and measure surface contamination and airborne radioactivity." ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "MobileRadiationMonitor"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :MobileRadiationMonitor ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "A Radiation Monitor is a device used to detect and measure radiation fields in the vicinity of a radiation source, evaluate radiation contamination of patients, equipment, or the environment, and measure surface contamination and airborne radioactivity." ;
   rdfs:isDefinedBy "https://www.sciencedirect.com/topics/nursing-and-health-professions/radiation-monitor#definition"
 ] .


###  https://w3id.org/emmo/domain/neo#FullFaceMask
:FullFaceMask rdf:type owl:Class ;
                         rdfs:subClassOf :SafetyCriticalEquipment ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "NPPFullFaceMask"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Facepiece which covers the eyes, nose, mouth, and chin and provides adequate sealing on the face of the wearer of a respiratory protective device against the ambient atmosphere "@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "FullFaceMask"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :FullFaceMask ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Facepiece which covers the eyes, nose, mouth, and chin and provides adequate sealing on the face of the wearer of a respiratory protective device against the ambient atmosphere "@en ;
   :referenceISO """ISO 11999-1:2015(en) 
PPE for firefighters — Test methods and requirements for PPE used by firefighters who are at risk of exposure to high levels of heat and/or flame while fighting fires occurring in structures — Part 1: General """^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#AutomaticMonitoring
:AutomaticMonitoring rdf:type owl:Class ;
                         rdfs:subClassOf :Controlling ;
                         rdfs:comment "Automatic function which ensures that a protective measure (3.36) is initiated if the ability of the SRP/CS to perform a function is diminished, or if the process conditions are changed such that hazards are generated"@en ;
                         rdfs:seeAlso <https://www.iso.org/obp/ui/en/#iso:std:iso:25119:-1:ed-2:v1:en:term:3.33> ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "AutomaticManipulation"@en ;
                         <http://www.w3.org/2004/02/skos/core#comment> "Missed DefinedBy and definition" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "AutomaticMonitoring"@en .


###  https://w3id.org/emmo/domain/neo#EmergencyOperationProcedures
:EmergencyOperationProcedures rdf:type owl:Class ;
                         rdfs:subClassOf :EmergencyManagement ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "EOP"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Plant procedures that direct operators' actions necessary to mitigate the consequences of transients and accidents that have caused plant parameters to exceed reactor protection system set points or engineered safety feature set points, or other established limits." ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "EmergencyOperationProcedures"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :EmergencyOperationProcedures ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Plant procedures that direct operators' actions necessary to mitigate the consequences of transients and accidents that have caused plant parameters to exceed reactor protection system set points or engineered safety feature set points, or other established limits." ;
   :referenceNRC "https://www.nrc.gov/docs/ML1025/ML102560007.pdf"^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#ReactorPreventiveSystems
:ReactorPreventiveSystems rdf:type owl:Class ;
                         rdfs:subClassOf :SafetySystem ;
                         rdfs:comment """The ﬁrst level of defense against ﬁssion product release is to design to prevent the
occurrence of any event that could result in damage to the fuel or other reactor
system. Negative reactivity coefﬁcients that lead to inherently stable operating con-
ditions, safety margins in design, reliable and known materials performance in
structures and components, adequate instrumentation and control, and so on, are
among the preventive measures employed in reactor design""" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ReactorPreventiveSystems"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ReactorPreventiveSystems ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget """The ﬁrst level of defense against ﬁssion product release is to design to prevent the
occurrence of any event that could result in damage to the fuel or other reactor
system. Negative reactivity coefﬁcients that lead to inherently stable operating con-
ditions, safety margins in design, reliable and known materials performance in
structures and components, adequate instrumentation and control, and so on, are
among the preventive measures employed in reactor design""" ;
   rdfs:seeAlso "Stacey: Nuclear Reactor Physics"
 ] .


