                                                rdfs:subPropertyOf rdfs:label .


###  https://w3id.org/emmo/domain/neo#comment
:comment rdf:type owl:AnnotationProperty ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "comment"@en ;
         :definition "Additional text aimed to explain the conceptual choices of the authors."@en ;
         rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/emmo/domain/neo#definition
:definition rdf:type owl:AnnotationProperty ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "definition"@en ;
            :definition "A short explanation aimed to guide the reader towards the intended interpretation of the ontological concept."@en ;
            rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/emmo/domain/neo#example
:example rdf:type owl:AnnotationProperty ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "example"@en ;
         :definition "A reference to real entities aimed to explain the intended interpretation for the ontological concept."@en ;
         rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/emmo/domain/neo#referenceARIS
:referenceARIS rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to the IAEA Advanced Reactor Information System Glossary  that might provide additional information about the subject resource."@en ;
               rdfs:seeAlso <https://aris.iaea.org/Glossary/> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "ARIS Reference"@en ;
