@prefix : <https://w3id.org/emmo/domain/neo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix elite: <https://w3id.org/emmo/0.0.7/elite#> .
@base <https://w3id.org/emmo/domain/neo#> .

<https://w3id.org/emmo/domain/neo/neo> rdf:type owl:Ontology ;
                                        owl:versionIRI <https://w3id.org/emmo/domain/neo/0.0.3/neo> ;
                                        owl:imports <https://w3id.org/emmo/elite/elite/0.0.7> ;
                                        <http://purl.org/dc/terms/contributor> "Anna Anchini"@it ,
                                                                               "Cristiana Tropeano"@it ,
                                                                               "Dario Rimondini"@it ,
                                                                               "Francesca Venturi"@it ,
                                                                               "Francesco Antonio Zaccarini"@it ,
                                                                               "Giovanna Casula"@it ,
                                                                               "Ilaria Maria Paponetti"@it ,
                                                                               "Nicola Ferro"@it ,
                                                                               "Samuele Baldini"@it ,
                                                                               "Saverio Quaranta"@it ;
                                        <http://purl.org/dc/terms/creator> "Emanuele Ghedini"@it .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty ;
                                               rdfs:subPropertyOf rdfs:label .


###  http://www.w3.org/2004/02/skos/core#comment
<http://www.w3.org/2004/02/skos/core#comment> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty ;
                                                rdfs:subPropertyOf rdfs:label .


###  https://w3id.org/emmo/domain/neo#comment
:comment rdf:type owl:AnnotationProperty ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "comment"@en ;
         :definition "Additional text aimed to explain the conceptual choices of the authors."@en ;
         rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/emmo/domain/neo#definition
:definition rdf:type owl:AnnotationProperty ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "definition"@en ;
            :definition "A short explanation aimed to guide the reader towards the intended interpretation of the ontological concept."@en ;
            rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/emmo/domain/neo#example
:example rdf:type owl:AnnotationProperty ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "example"@en ;
         :definition "A reference to real entities aimed to explain the intended interpretation for the ontological concept."@en ;
         rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/emmo/domain/neo#isoDefinition
:isoDefinition rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to the ISO term defining the subject resource."@en ;
               rdfs:seeAlso <https://www.iso.org/obp> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "ISO Definition"@en ;
               rdfs:subPropertyOf rdfs:isDefinedBy ;
               rdfs:range xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#referenceARIS
:referenceARIS rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to the IAEA Advanced Reactor Information System Glossary  that might provide additional information about the subject resource."@en ;
               rdfs:seeAlso <https://aris.iaea.org/Glossary/> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "ARIS Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso .


###  https://w3id.org/emmo/domain/neo#referenceIAEA
:referenceIAEA rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to IAEA publication that might provide additional information about the subject resource."@en ;
               rdfs:seeAlso <https://www.iaea.org/> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "IAEA Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso .


###  https://w3id.org/emmo/domain/neo#referenceINIS
:referenceINIS rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to the IAEA INIS Thesaurus term  that might provide additional information about the subject resource."@en ,
                            "Since IRIs for INIS Thesaurus concepts are not available, a reference to the term is provided using literal values."@en ;
               rdfs:seeAlso <https://www.iaea.org/resources/databases/inis/thesaurus> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "INIS Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso .


###  https://w3id.org/emmo/domain/neo#referenceISO
:referenceISO rdf:type owl:AnnotationProperty ;
              rdfs:comment "Reference to ISO standards that might provide additional information about the subject resource."@en ;
              rdfs:seeAlso <https://www.iso.org/obp/ui/#home> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "ISO Reference"@en ;
              rdfs:subPropertyOf rdfs:seeAlso .


###  https://w3id.org/emmo/domain/neo#referenceNCTG
:referenceNCTG rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference te the Glossary of Nuclear Criticality Terms. Los Alamos National Laboratory (1989)  that might provide additional information about the subject resource."@en ;
               rdfs:seeAlso "https://ncsp.llnl.gov/sites/ncsp/files/2021-05/la11627.pdf" ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "NCTG Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso .


###  https://w3id.org/emmo/domain/neo#referenceNRCG
:referenceNRCG rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to the Nuclear Regulatory Commission Glossary  that might provide additional information about the subject resource."@en ;
               rdfs:seeAlso <https://www.nrc.gov/reading-rm/basic-ref/glossary> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "NRCG Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso ;
               rdfs:range xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#referenceNSSG
:referenceNSSG rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to IAEA Nuclear Safety and Security Glossary term IRI  that might provide additional information about the subject resource."@en ;
               rdfs:seeAlso <https://vocabulary.iaea.org/iaea-safety-glossary.html> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "NSSG Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso ;
               rdfs:range xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#referenceeCFR
:referenceeCFR rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to the official U.S. federal regulations database, maintained by the National Archives  that might provide additional information about the subject resource."@en ;
               rdfs:seeAlso <https://www.ecfr.gov/> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "eCFR Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso .


###  https://w3id.org/emmo/domain/neo/neo#isoDefinition
:isoDefinition rdf:type owl:AnnotationProperty .


###  https://w3id.org/emmo/domain/neo/neo-source#NSSG_Definition
<https://w3id.org/emmo/domain/neo/neo-source#NSSG_Definition> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/emmo/0.0.7/elite#isConstituentOf
elite:isConstituentOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isConstitutiveProcessOf
elite:isConstitutiveProcessOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isInputOf
elite:isInputOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isOutputOf
elite:isOutputOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isStageOf
elite:isStageOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#participatesTo
elite:participatesTo rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/domain/neo#RB4rNlczhggIx7lqdEK2d9c
:RB4rNlczhggIx7lqdEK2d9c rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/emmo/domain/fukushima#lossOfUltimateHeatSink
<https://w3id.org/emmo/domain/fukushima#lossOfUltimateHeatSink> rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#Atom
:Atom rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#BoilingWaterReactor
:BoilingWaterReactor rdf:type owl:Class ;
                     rdfs:subClassOf :Light_Water_Reactor ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "BWR"@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Boiling Water Reactor"@en ;
                     :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-2:v1:en:term:3.3.1.13> .


###  https://w3id.org/emmo/domain/neo#CommonSpentFuelBuilding
:CommonSpentFuelBuilding rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#ControlRodGroup
:ControlRodGroup rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#DC_Operational_Power_Source
:DC_Operational_Power_Source rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#DryWell
:DryWell rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#FastNeutron
:FastNeutron rdf:type owl:Class ;
             rdfs:subClassOf :Neutron ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty elite:isOutputOf ;
                               owl:someValuesFrom :NuclearFission
                             ] ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Fast Neutron"@en ;
             :comment """Fast neutrons are considered as such in the context of a fission nuclear reactor, where the average neutron energy emerging from fission is about 2 MeV, before being slowed down by collisions. 
While in some textbooks you can find a defnition of fast neutron as a neutron with E > 50 keV, there is not a clear definition of the range within which a neutron can be considered \"fast\"."""@en ;
             :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-2:v1:en:term:3.2.19> .


###  https://w3id.org/emmo/domain/neo#Fertile_Nuclide
:Fertile_Nuclide rdf:type owl:Class ;
                 rdfs:subClassOf :Nuclide ;
                 <http://www.w3.org/2004/02/skos/core#comment> "A nuclide, which is not itself fissile (fissionable by thermal neutrons), that can be converted into a fissile nuclide by irradiation in a reactor. There are two basic fertile materials: uranium-238 and thorium-232. When these fertile materials capture neutrons, they are converted into fissile plutonium-239 and uranium-233, respectively." ;
                 :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-2:v1:en:term:3.2.5> ;
                 :referenceNRCG "Fertile Material"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fertile_Nuclide ;
   owl:annotatedProperty :referenceNRCG ;
   owl:annotatedTarget "Fertile Material"^^xsd:anyURI ;
   rdfs:comment "Misleading Label and definition"
 ] .


###  https://w3id.org/emmo/domain/neo#Fissile_Nuclide
:Fissile_Nuclide rdf:type owl:Class ;
                 rdfs:subClassOf :Nuclide ;
                 <http://www.w3.org/2004/02/skos/core#comment> "A nuclide that is capable of undergoing fission after capturing low-energy thermal (slow) neutrons." ;
                 :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-2:v1:en:term:3.2.4> ;
                 :referenceNCTG "Fissile nucleus" ;
                 :referenceNRCG "Fissile Material"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fissile_Nuclide ;
   owl:annotatedProperty :referenceNRCG ;
   owl:annotatedTarget "Fissile Material"^^xsd:anyURI ;
   rdfs:comment "this label can generate misunderstanding"
 ] .


###  https://w3id.org/emmo/domain/neo#FissionProduct
:FissionProduct rdf:type owl:Class ;
                rdfs:subClassOf :Atom ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty elite:isOutputOf ;
                                  owl:someValuesFrom :NuclearFission
                                ] ;
                rdfs:comment "Used in contexts where the radiation emitted by the radionuclide is the potential hazard."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Fission Product"@en ;
                :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-2:v1:en:term:3.2.6> ;
                <https://w3id.org/emmo/domain/neo/neo-source#NSSG_Definition> "https://vocabulary.iaea.org/iaea-safety-glossary/961.html"^^xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#Fissionable_Nuclide
:Fissionable_Nuclide rdf:type owl:Class ;
                     rdfs:subClassOf :Nuclide ;
                     <http://www.w3.org/2004/02/skos/core#comment> "Si dirà che U235 è fissile, mentre U238 che richiede energia non trascurabile per scindersi è fissionabile"@it ;
                     <http://www.w3.org/2004/02/skos/core#definition> """A nucleus capable of fission by neutrons of some
energy. Fissionable nuclei include 238U, 240Pu, and others with
neutron-energy fission thresholds, in addition to those that are fissile.
See fissile nucleus."""@en ;
                     :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-3:ed-2:v1:en:term:3.1.7> ;
                     :referenceNCTG "Fissionable Nucleus" ;
                     :referenceNRCG "Fissionable Material"^^xsd:anyURI ;
                     :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/963.html> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fissionable_Nuclide ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#comment> ;
   owl:annotatedTarget "Si dirà che U235 è fissile, mentre U238 che richiede energia non trascurabile per scindersi è fissionabile"@it ;
   rdfs:seeAlso "Montagnini"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fissionable_Nuclide ;
   owl:annotatedProperty :referenceNRCG ;
   owl:annotatedTarget "Fissionable Material"^^xsd:anyURI ;
   rdfs:comment "Misleading"
 ] .


###  https://w3id.org/emmo/domain/neo#FuelAssembly
:FuelAssembly rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#FuelElement
:FuelElement rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#HeadVentNozzle
:HeadVentNozzle rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#InjectedMaterial
:InjectedMaterial rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#InjectionSystem
:InjectionSystem rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#Light_Water_Reactor
:Light_Water_Reactor rdf:type owl:Class ;
                     rdfs:subClassOf :NuclearReactor ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty elite:isConstituentOf ;
                                       owl:someValuesFrom :NuclearPowerPlant
                                     ] ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "LWR" ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Light Water Reactor"@en ;
                     :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-2:v1:en:term:3.3.1.10> .


###  https://w3id.org/emmo/domain/neo#MainControlRoom
:MainControlRoom rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#MultipleUnitNuclearPowerPlant
:MultipleUnitNuclearPowerPlant rdf:type owl:Class ;
                               rdfs:subClassOf :NuclearPowerPlant ;
                               rdfs:comment "The nuclear reactors and the electric production lines can be either almost identical or different between them, though usually sharing various support or auxiliary installations, systems and/or supplies"@en ;
                               <http://www.w3.org/2004/02/skos/core#altLabel> "Multiple Unit NPP"@en ;
                               <http://www.w3.org/2004/02/skos/core#example> "Tennessee Valley Authority Browns Ferry Nuclear Plant (Athens, Alabama, United States)"@en ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Multiple Unit Nuclear Power Plant"@en ;
                               :isoDefinition <https://www.iso.org/obp/ui/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.4.1.2> .


###  https://w3id.org/emmo/domain/neo#NPPOperationManagement
:NPPOperationManagement rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#NPPProtection
:NPPProtection rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#Neutron
:Neutron rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#NeutronInducedFission
:NeutronInducedFission rdf:type owl:Class ;
                       rdfs:subClassOf :NuclearFission ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty elite:isStageOf ;
                                         owl:someValuesFrom :NuclearChainReaction
                                       ] ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Neutron Induced Fission"@en ;
                       :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-2:v1:en:term:3.2.2> .


###  https://w3id.org/emmo/domain/neo#NoNuclearISO
:NoNuclearISO rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#NuclearChainReaction
:NuclearChainReaction rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#NuclearEnergyObject
:NuclearEnergyObject rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#NuclearFission
:NuclearFission rdf:type owl:Class ;
                rdfs:subClassOf :NuclearReaction ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty elite:isConstitutiveProcessOf ;
                                  owl:someValuesFrom :FuelAssembly
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty elite:isConstitutiveProcessOf ;
                                  owl:someValuesFrom :FuelElement
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty [ owl:inverseOf elite:isOutputOf
                                                 ] ;
                                  owl:someValuesFrom :FissionProduct
                                ] ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Fission"@en ;
                :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-1:ed-1:v1:en:term:3.2.2> ;
                :referenceINIS "FISSION"@en .


###  https://w3id.org/emmo/domain/neo#NuclearIsland
:NuclearIsland rdf:type owl:Class ;
               rdfs:subClassOf :NuclearEnergyObject ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty elite:isConstituentOf ;
                                 owl:someValuesFrom :NuclearPowerPlant
                               ] ;
               rdfs:seeAlso <https://www-pub.iaea.org/MTCD/Publications/PDF/P1526_Web.pdf> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Island"@en ;
               :isoDefinition <https://www.iso.org/obp/ui#iso:std:iso:12749:-5:ed-1:v1:en:term:3.1.23> .


###  https://w3id.org/emmo/domain/neo#NuclearPlantWorker
:NuclearPlantWorker rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#NuclearPowerPlant
:NuclearPowerPlant rdf:type owl:Class ;
                   rdfs:subClassOf :NuclearEnergyObject ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty elite:participatesTo ;
                                     owl:someValuesFrom :NPPOperationManagement
                                   ] ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "NPP"@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Power Plant"@en ;
                   :isoDefinition <https://www.iso.org/obp/ui/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.2.5> .


###  https://w3id.org/emmo/domain/neo#NuclearPowerPlantBuilding
:NuclearPowerPlantBuilding rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#NuclearPowerPlantUnit
:NuclearPowerPlantUnit rdf:type owl:Class ;
                       rdfs:subClassOf :NuclearEnergyObject ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty elite:isConstituentOf ;
                                         owl:someValuesFrom :NuclearPowerPlant
                                       ] ;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "NPP Unit"@en ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> <https://www.iso.org/obp/ui/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.4.4> ,
                                                                       "Nuclear Power Plant Unit"@en ;
                       :example "The NPP unit includes the nuclear reactor plus all its associated systems and buildings not shared by other nuclear reactors (ISO 12749-5:2018)"@en .


###  https://w3id.org/emmo/domain/neo#NuclearPowerReactor
:NuclearPowerReactor rdf:type owl:Class ;
                     rdfs:subClassOf :NuclearReactor ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty elite:isConstituentOf ;
                                       owl:someValuesFrom :NuclearPowerPlant
                                     ] ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Power Reactor"@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Power Reactor"@en ;
                     :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-2:v1:en:term:3.3.1.1> .


###  https://w3id.org/emmo/domain/neo#NuclearReaction
:NuclearReaction rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#NuclearReactor
:NuclearReactor rdf:type owl:Class ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Nuclear Reactor"@en ;
                :referenceINIS "HYBRID REACTORS" ,
                               "REACTORS" ,
                               "THERMONUCLEAR REACTORS" ;
                :isoDefinition <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.1.22> .


###  https://w3id.org/emmo/domain/neo#Nuclide
:Nuclide rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#PipePlantValve
:PipePlantValve rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#PlantTurbine
:PlantTurbine rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#PowerSupplySystem
:PowerSupplySystem rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#PreassureIncreasing
:PreassureIncreasing rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#PressureReliefValve
:PressureReliefValve rdf:type owl:Class .


###  https://w3id.org/emmo/domain/neo#PressureRelieveValve
:PressureRelieveValve rdf:type owl:Class .


