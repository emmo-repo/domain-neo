@prefix : <https://w3id.org/emmo/domain/neo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix elite: <https://w3id.org/emmo/0.0.7/elite#> .
@base <https://w3id.org/emmo/domain/neo#> .

<https://w3id.org/emmo/domain/neo/neo-core> rdf:type owl:Ontology ;
                                             owl:versionIRI <https://w3id.org/emmo/domain/neo/0.0.1/neo-core> ;
                                             owl:imports <https://w3id.org/emmo/0.0.7/elite> ,
                                             <http://purl.org/dc/terms/contributor> "Ilaria Maria Paponetti"@it ,
                                                                                    "Emanuele Ghedini" ,
                                                                                    "Karl Sturm" ;
                                             <http://purl.org/dc/terms/description> "The Nuclear Energy Ontology is a core ontology developed within the EMMO framework. It contains the fundamental concepts and terminology of the nuclear energy domain, providing the common semantic foundation that is reused and extended by more specialized nuclear ontologies. The ontology is grounded in internationally recognized standards, regulations, and technical references from ISO, IAEA, the U.S. Nuclear Regulatory Commission, and other authoritative sources."@en ;
                                             <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:anyURI ;
                                             <http://purl.org/dc/terms/title> "Nuclear Energy Core Ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty ;
                                               rdfs:subPropertyOf rdfs:label .


###  http://www.w3.org/2004/02/skos/core#comment
<http://www.w3.org/2004/02/skos/core#comment> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
<http://www.w3.org/2004/02/skos/core#example> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty ;
                                                rdfs:subPropertyOf rdfs:label .


###  https://w3id.org/emmo/0.0.7/elite#isOutputOf
elite:isOutputOf rdf:type owl:AnnotationProperty ;
                 rdfs:subPropertyOf elite:partakesIn .


###  https://w3id.org/emmo/0.0.7/elite#partakesIn
elite:partakesIn rdf:type owl:AnnotationProperty .


###  https://w3id.org/emmo/domain/neo#IAEA_Reference
:IAEA_Reference rdf:type owl:AnnotationProperty ;
                rdfs:comment ""@en ;
                rdfs:subPropertyOf rdfs:seeAlso .


###  https://w3id.org/emmo/domain/neo#NCTG_Reference
:NCTG_Reference rdf:type owl:AnnotationProperty ;
                rdfs:comment """Glossary of Nuclear Criticality Terms. Los Alamos National
Laboratory, 1989""" ;
                rdfs:seeAlso "https://ncsp.llnl.gov/sites/ncsp/files/2021-05/la11627.pdf" ;
                rdfs:subPropertyOf rdfs:seeAlso .


###  https://w3id.org/emmo/domain/neo#NRC_Reference
:NRC_Reference rdf:type owl:AnnotationProperty ;
               rdfs:comment "This is the link to any Nuclear Regulatory Commission document/report."@en ;
               rdfs:subPropertyOf rdfs:seeAlso ;
               rdfs:range xsd:string .


###  https://w3id.org/emmo/domain/neo#R8xx0dhbEh1tjGMDwNZfckV
:R8xx0dhbEh1tjGMDwNZfckV rdf:type owl:AnnotationProperty ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "definition"@en ;
                         :R8xx0dhbEh1tjGMDwNZfckV "A short explanation aimed to guide the reader towards the intended interpretation of the ontological concept."@en ;
                         rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/emmo/domain/neo#R9Q7fCgWnAkzqnVMtRJ4WDv
:R9Q7fCgWnAkzqnVMtRJ4WDv rdf:type owl:AnnotationProperty ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "example"@en ;
                         :R8xx0dhbEh1tjGMDwNZfckV "A reference to real entities aimed to explain the intended interpretation for the ontological concept."@en ;
                         rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/emmo/domain/neo#RR3uD2d7YfhHohfv2Nm6sX
:RR3uD2d7YfhHohfv2Nm6sX rdf:type owl:AnnotationProperty ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "comment"@en ;
                        :R8xx0dhbEh1tjGMDwNZfckV "Additional text aimed to explain the conceptual choices of the authors."@en ;
                        rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/emmo/domain/neo#eCFR_Reference
:eCFR_Reference rdf:type owl:AnnotationProperty ;
                rdfs:comment "Official U.S. federal regulations database, maintained by the National Archives." ;
                :eCFR_Reference ""^^xsd:anyURI ;
                rdfs:subPropertyOf rdfs:seeAlso ;
                rdfs:range xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#referenceARIS
:referenceARIS rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to the IAEA Advanced Reactor Information System Glossary."@en ;
               rdfs:seeAlso <https://aris.iaea.org/Glossary/> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "ARIS Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso ;
               rdfs:range xsd:string .


###  https://w3id.org/emmo/domain/neo#referenceINIS
:referenceINIS rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to the IAEA INIS Thesaurus term."@en ;
               rdfs:seeAlso <https://www.iaea.org/resources/databases/inis/thesaurus> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "INIS Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso ;
               rdfs:range xsd:string .


###  https://w3id.org/emmo/domain/neo#referenceISO
:referenceISO rdf:type owl:AnnotationProperty ;
              rdfs:seeAlso <https://www.iso.org/obp/ui/#home> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "ISO Reference"@en ;
              rdfs:subPropertyOf rdfs:seeAlso ;
              rdfs:range xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#referenceNRC
:referenceNRC rdf:type owl:AnnotationProperty ;
              rdfs:comment "This is the direct reference to the Nuclear Regulatory Commission Glossary" ;
              rdfs:seeAlso <https://www.nrc.gov/reading-rm/basic-ref/glossary> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "NRCG Reference"@en ;
              rdfs:subPropertyOf rdfs:seeAlso ;
              rdfs:range xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#referenceNSSG
:referenceNSSG rdf:type owl:AnnotationProperty ;
               rdfs:comment "Reference to IAEA Nuclear Safety and Security Glossary term IRI."@en ;
               rdfs:seeAlso <https://vocabulary.iaea.org/iaea-safety-glossary.html> ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "NSSG Reference"@en ;
               rdfs:subPropertyOf rdfs:seeAlso ;
               rdfs:range xsd:anyURI .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/emmo/0.0.7/elite#affects
elite:affects rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#foregoes
elite:foregoes rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#hasBehaviour
elite:hasBehaviour rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isBehaviourOf
elite:isBehaviourOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isConstituentOf
elite:isConstituentOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isConstitutiveProcessOf
elite:isConstitutiveProcessOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isInputOf
elite:isInputOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isParticipantOf
elite:isParticipantOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isStageOf
elite:isStageOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#isSubProcessOf
elite:isSubProcessOf rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/0.0.7/elite#participatesTo
elite:participatesTo rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/domain/neo#RB4rNlczhggIx7lqdEK2d9c
:RB4rNlczhggIx7lqdEK2d9c rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf elite:isConstituentOf ;
                         rdfs:comment "Defines the position of an object in a Nuclear Power Plant."@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "The spatial relation  between an entity and another the entity that contains it."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "isContainedBy"@en .


###  https://w3id.org/emmo/domain/neo#has_Constituent
:has_Constituent rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/domain/neo#has_Inner_Radius
:has_Inner_Radius rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:comment "need definition" .


###  https://w3id.org/emmo/domain/neo#has_Outer_Radius
:has_Outer_Radius rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:comment "need definition" .


###  https://w3id.org/emmo/domain/neo#has_Role
:has_Role rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdfs:domain :Reactor_Core ;
          rdfs:range :Reactor_Core_Role .


###  https://w3id.org/emmo/domain/neo#is_made_up_of
:is_made_up_of rdf:type owl:ObjectProperty .


###  https://w3id.org/emmo/hume#hasProperty
<https://w3id.org/emmo/hume#hasProperty> rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/emmo/domain/neo#ActivatedMaterial
:ActivatedMaterial rdf:type owl:Class ;
                   rdfs:subClassOf :NuclearMaterial ;
                   rdfs:comment "the definition is not correct: Mix between nuclide and material" ;
                   rdfs:isDefinedBy <https://en.wikipedia.org/wiki/Activation_product> ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An activation product is a material that has been made radioactive by the process of neutron activation."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Activated Material"@en ;
                   :RR3uD2d7YfhHohfv2Nm6sX "Fission products and actinides produced by neutron absorption of nuclear fuel itself are normally referred to by those specific names, and activation product reserved for products of neutron capture by other materials, such as structural components of the nuclear reactor or nuclear bomb, the reactor coolant, control rods or other neutron poisons, or materials in the environment. All of these, however, need to be handled as radioactive waste. Some nuclides originate in more than one way, as activation products or fission products."@en .


###  https://w3id.org/emmo/domain/neo#Atom
:Atom rdf:type owl:Class ;
      rdfs:subClassOf <https://w3id.org/emmo/hume#PhysicalParticle> ;
      rdfs:isDefinedBy <https://doi.org/10.1351/goldbook.C01022> ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "Chemical Element"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "type of substance that cannot be divided or changed into different substances by ordinary chemical methods"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Atom"@en ;
      :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:10303:-2:ed-1:v1:en:term:3.1.21> .


###  https://w3id.org/emmo/domain/neo#BoilingWaterReactor
:BoilingWaterReactor rdf:type owl:Class ;
                     rdfs:subClassOf :Light_Water_Reactor ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "BWR"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> """nuclear reactor (3.1.22) with water as a coolant and as a moderator (3.1.23.1.2), boiling in the core 
Note 1 to entry: In a boiling water reactor the generated heat is removed from the core by evaporation. """@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Boiling Water Reactor"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :BoilingWaterReactor ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget """nuclear reactor (3.1.22) with water as a coolant and as a moderator (3.1.23.1.2), boiling in the core 
Note 1 to entry: In a boiling water reactor the generated heat is removed from the core by evaporation. """@en ;
   :referenceISO "ISO 12749-5:2018(en) Nuclear energy, nuclear technologies, and radiological protection — Vocabulary — Part 5: Nuclear reactors "^^xsd:anyURI
 ] .


###  https://w3id.org/emmo/domain/neo#BoratedWater
:BoratedWater rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/emmo/hume#Fluid> ;
              rdfs:seeAlso "https://www.columbuschemical.com/MSDS/SDS/Borated%20Water%200881.pdf" ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Injected Borated Water" ;
              <http://www.w3.org/2004/02/skos/core#definition> "Boron, often in the form of boric acid or sodium borate, is combined with water where it acts as a coolant to remove heat from the reactor core and transfers the heat to a secondary circuit." ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Borated Water"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :BoratedWater ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Boron, often in the form of boric acid or sodium borate, is combined with water where it acts as a coolant to remove heat from the reactor core and transfers the heat to a secondary circuit." ;
   rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Nuclear_reactor_coolant"
 ] .


###  https://w3id.org/emmo/domain/neo#Cladding
:Cladding rdf:type owl:Class ;
          rdfs:subClassOf :NuclearEnergyObject ;
          rdfs:comment "The thin-walled metal tube that forms the outer jacket of a nuclear fuel rod. It prevents corrosion of the fuel by the coolant and the release of fission products into the coolant. Aluminum, stainless steel, and zirconium alloys are common cladding materials." ;
          :referenceNRC <https://www.nrc.gov/reading-rm/basic-ref/glossary/cladding> .


###  https://w3id.org/emmo/domain/neo#FastNeutron
:FastNeutron rdf:type owl:Class ;
             rdfs:subClassOf :Neutron ;
             <http://www.w3.org/2004/02/skos/core#definition> "A neutron with kinetic energy greater than its surroundings when released during fission."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Fast Neutron"@en ;
             :RR3uD2d7YfhHohfv2Nm6sX """Fast neutrons are considered as such in the context of a fission nuclear reactor, where the average neutron energy emerging from fission is about 2 MeV, before being slowed down by collisions. 
While in some textbooks you can find a defnition of fast neutron as a neutron with E > 50 keV, there is not a clear definition of the range within which a neutron can be considered \"fast\"."""@en ;
             :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-5:ed-1:v1:en:term:3.1.5.1> .


###  https://w3id.org/emmo/domain/neo#Fertile_Nuclide
:Fertile_Nuclide rdf:type owl:Class ;
                 rdfs:subClassOf :Nuclide ;
                 <http://www.w3.org/2004/02/skos/core#comment> "A nuclide, which is not itself fissile (fissionable by thermal neutrons), that can be converted into a fissile nuclide by irradiation in a reactor. There are two basic fertile materials: uranium-238 and thorium-232. When these fertile materials capture neutrons, they are converted into fissile plutonium-239 and uranium-233, respectively." ;
                 :referenceNRC "Fertile Material"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fertile_Nuclide ;
   owl:annotatedProperty :referenceNRC ;
   owl:annotatedTarget "Fertile Material"^^xsd:anyURI ;
   rdfs:comment "Misleading Label and definition"
 ] .


###  https://w3id.org/emmo/domain/neo#Fissile_Nuclide
:Fissile_Nuclide rdf:type owl:Class ;
                 rdfs:subClassOf :Nuclide ;
                 <http://www.w3.org/2004/02/skos/core#comment> "A nuclide that is capable of undergoing fission after capturing low-energy thermal (slow) neutrons." ;
                 <http://www.w3.org/2004/02/skos/core#definition> """A nucleus capable of fission by thermal neutrons,
provided the effective neutron production cross section, exceeds
the effective absorption cross section. The common fissile nuclei
are 235U,239P~, and233U.1""" ;
                 :NCTG_Reference "Fissile nucleus" ;
                 :referenceNRC "Fissile Material"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fissile_Nuclide ;
   owl:annotatedProperty :referenceNRC ;
   owl:annotatedTarget "Fissile Material"^^xsd:anyURI ;
   rdfs:comment "this label can generate misunderstanding"
 ] .


###  https://w3id.org/emmo/domain/neo#FissionProduct
:FissionProduct rdf:type owl:Class ;
                rdfs:subClassOf :Atom ;
                rdfs:comment "Used in contexts where the radiation emitted by the radionuclide is the potential hazard."@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A radionuclide produced by nuclear fission."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Fission Product"@en ;
                :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/961.html"^^xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#Fissionable_Nuclide
:Fissionable_Nuclide rdf:type owl:Class ;
                     rdfs:subClassOf :Nuclide ;
                     <http://www.w3.org/2004/02/skos/core#comment> "Si dirà che U235 è fissile, mentre U238 che richiede energia non trascurabile per scindersi è fissionabile"@it ;
                     :NCTG_Reference "Fissionable Nucleus" ;
                     :R8xx0dhbEh1tjGMDwNZfckV """A nucleus capable of fission by neutrons of some
energy. Fissionable nuclei include 238U, 240Pu, and others with
neutron-energy fission thresholds, in addition to those that are fissile.
See fissile nucleus.""" ;
                     :referenceISO <https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-3:ed-2:v1:en:term:3.1.7> ;
                     :referenceNRC "Fissionable Material"^^xsd:anyURI ;
                     :referenceNSSG <https://vocabulary.iaea.org/iaea-safety-glossary/963.html> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fissionable_Nuclide ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#comment> ;
   owl:annotatedTarget "Si dirà che U235 è fissile, mentre U238 che richiede energia non trascurabile per scindersi è fissionabile"@it ;
   rdfs:seeAlso "Montagnini"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fissionable_Nuclide ;
   owl:annotatedProperty :referenceNRC ;
   owl:annotatedTarget "Fissionable Material"^^xsd:anyURI ;
   rdfs:comment "Misleading"
 ] .


###  https://w3id.org/emmo/domain/neo#Fresh_Pellet
:Fresh_Pellet rdf:type owl:Class ;
              rdfs:subClassOf :Fuel_Pellet ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty elite:isInputOf ;
                                owl:someValuesFrom :Neutron_Irradiation
                              ] ;
              owl:disjointWith :Irradiated_Pellet ;
              :R8xx0dhbEh1tjGMDwNZfckV "A fuel pellet that has not yet been subjected to an irradiation process within a nuclear reactor." .


###  https://w3id.org/emmo/domain/neo#FuelAssembly
:FuelAssembly rdf:type owl:Class ;
              rdfs:subClassOf :NuclearEnergyObject ;
              <http://www.w3.org/2004/02/skos/core#definition> """A set of fuel elements and associated components which are loaded into and
subsequently removed from a reactor core as a single unit."""@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Fuel Assembly"@en ;
              :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/974.html"^^xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#FuelElement
:FuelElement rdf:type owl:Class ;
             rdfs:subClassOf :NuclearEnergyObject ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty elite:isConstituentOf ;
                               owl:someValuesFrom :FuelAssembly
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <https://w3id.org/emmo/hume#hasPart> ;
                               owl:someValuesFrom :Cladding
                             ] ;
             rdfs:comment "Commonly referred to as a fuel rod in light water reactors."@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Fuel Element"@en ,
                                                            "Fuel Pin" ;
             <http://www.w3.org/2004/02/skos/core#definition> "A rod of nuclear fuel, its cladding and any associated components necessary to form a structural entity.﻿"@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Fuel Rod"@en ;
             :referenceNSSG "https://vocabulary.iaea.org/iaea-safety-glossary/976.html"^^xsd:anyURI .


###  https://w3id.org/emmo/domain/neo#Fuel_Pellet
:Fuel_Pellet rdf:type owl:Class ;
             rdfs:subClassOf :NuclearEnergyObject ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Nuclear Fuel Pellet" ;
             <http://www.w3.org/2004/02/skos/core#comment> "nuclear fuel (3.2.1) in ceramic form and with a cylindrical shape" ;
             <http://www.w3.org/2004/02/skos/core#definition> "nuclear fuel with a geometrical shape, and a chemical composition that is fabricated for nuclear civil reactor and research reactors."@en ;
             :R8xx0dhbEh1tjGMDwNZfckV "A discrete unit of nuclear fuel material, characterized by a specific ceramic form and cylindrical geometry, fabricated to serve as the structural basis for fuel rod integration. Its identity as a pellet is defined by its physical properties (shape, material matrix, dimensions) rather than its functional state within a reactor." ;
             :referenceISO "https://www.iso.org/obp/ui/en/#iso:std:iso:12749:-3:ed-2:v1:en:term:3.2.3"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fuel_Pellet ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#comment> ;
   owl:annotatedTarget "nuclear fuel (3.2.1) in ceramic form and with a cylindrical shape" ;
   rdfs:comment "the definition does not include types of pellet for fast reactor with other fors of other material matrix"
 ] .


###  https://w3id.org/emmo/domain/neo#Fuel_Pellet_Column
